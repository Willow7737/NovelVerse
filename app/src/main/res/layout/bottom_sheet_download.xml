<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/inter_semibold"
        android:text="Download Chapters"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingMultiplier="1.5"
        android:text="Downloads are saved for offline reading. Each chapter is ~300–500 KB."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_download_5"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_btn_squircle_primary"
        android:fontFamily="@font/inter_semibold"
        android:text="Next 5"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_download_10"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_btn_squircle_primary"
        android:fontFamily="@font/inter_semibold"
        android:text="Next 10"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_download_all"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_btn_squircle_primary"
        android:fontFamily="@font/inter_semibold"
        android:text="All Chapters"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btn_cancel_download"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:padding="8dp"
        android:text="Cancel"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp" />

</LinearLayout>
