<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:background="@android:color/transparent"
        android:id="@+id/swipe_refresh">

        <androidx.core.widget.NestedScrollView
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:background="@android:color/transparent"
            android:fillViewport="true"
            android:id="@+id/home_scroll">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:visibility="gone"
                    android:background="@drawable/bg_home_section_card"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:id="@+id/section_continue_reading">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="7dp"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="14dp">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            android:textSize="19sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="?attr/colorOnSurface"
                            android:letterSpacing="-0.01"
                            android:layout_weight="1"
                            android:text="@string/continue_reading" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:padding="4dp"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/primary"
                            android:id="@+id/btn_see_all_continue"
                            android:text="@string/see_all" />

                    </LinearLayout>

                    <com.novelverse.app.presentation.common.views.DottedDividerView
                        android:layout_height="2dp"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="16dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:paddingBottom="14dp"
                        android:clipToPadding="false"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:id="@+id/continue_reading_recycler" />

                </LinearLayout>

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:visibility="gone"
                    android:background="@drawable/bg_home_section_card"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:id="@+id/section_for_you">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="7dp"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="14dp">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            android:textSize="19sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="?attr/colorOnSurface"
                            android:letterSpacing="-0.01"
                            android:layout_weight="1"
                            android:text="@string/for_you" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:padding="4dp"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/primary"
                            android:id="@+id/btn_see_all_for_you"
                            android:text="@string/see_all" />

                    </LinearLayout>

                    <com.novelverse.app.presentation.common.views.DottedDividerView
                        android:layout_height="2dp"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="16dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:paddingBottom="14dp"
                        android:clipToPadding="false"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:id="@+id/for_you_recycler" />

                </LinearLayout>

                <HorizontalScrollView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:scrollbars="none"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp"
                    android:paddingStart="16dp"
                    android:paddingTop="18dp">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/genre_pill_container">

                    </LinearLayout>

                </HorizontalScrollView>

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_home_section_card"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="7dp"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="14dp">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            android:textSize="20sp"
                            android:fontFamily="@font/nunito_semibold"
                            android:textColor="?attr/colorOnSurface"
                            android:letterSpacing="-0.01"
                            android:layout_weight="1"
                            android:text="@string/trending" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:padding="4dp"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/primary"
                            android:id="@+id/btn_see_all_trending"
                            android:text="@string/view_all" />

                    </LinearLayout>

                    <com.novelverse.app.presentation.common.views.DottedDividerView
                        android:layout_height="2dp"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="16dp" />

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:id="@+id/shimmer_trending">

                        <include
                            layout="@layout/shimmer_home_section" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:paddingBottom="14dp"
                        android:clipToPadding="false"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:id="@+id/trending_recycler" />

                </LinearLayout>

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_home_section_card"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="7dp"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="14dp">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            android:textSize="20sp"
                            android:fontFamily="@font/nunito_semibold"
                            android:textColor="?attr/colorOnSurface"
                            android:letterSpacing="-0.01"
                            android:layout_weight="1"
                            android:text="@string/new_releases" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:padding="4dp"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/primary"
                            android:id="@+id/btn_see_all_new_releases"
                            android:text="@string/view_all" />

                    </LinearLayout>

                    <com.novelverse.app.presentation.common.views.DottedDividerView
                        android:layout_height="2dp"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="16dp" />

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:id="@+id/shimmer_new_releases">

                        <include
                            layout="@layout/shimmer_home_section" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:paddingBottom="14dp"
                        android:clipToPadding="false"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:id="@+id/new_releases_recycler" />

                </LinearLayout>

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_home_section_card"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:id="@+id/section_community_reviews">

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="7dp"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="14dp">

                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_weight="1">

                            <TextView
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:textSize="19sp"
                                android:fontFamily="@font/nunito_semibold"
                                android:textColor="?attr/colorOnSurface"
                                android:letterSpacing="-0.01"
                                android:text="Community Reviews" />

                        </LinearLayout>

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:padding="4dp"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_semibold"
                            android:textColor="@color/primary"
                            android:id="@+id/btn_see_all_reviews"
                            android:text="@string/see_all" />

                    </LinearLayout>

                    <com.novelverse.app.presentation.common.views.DottedDividerView
                        android:layout_height="2dp"
                        android:layout_width="match_parent"
                        android:layout_marginHorizontal="16dp" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:layout_height="194dp"
                        android:layout_width="match_parent"
                        android:layout_marginTop="4dp"
                        android:id="@+id/reviews_pager"
                        android:overScrollMode="never" />

                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/reviews_dots"
                        android:layout_gravity="center_horizontal">

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/btn_quests_fab_container"
        android:layout_width="125dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/img_quests_text_bg"
        android:clickable="true"
        android:clipChildren="true"
        android:elevation="6dp"
        android:focusable="true">

        <ImageView
            android:id="@+id/quests_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_quests"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/quests_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="42dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/inter_semibold"
            android:text="Quests"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </FrameLayout>

</FrameLayout>
