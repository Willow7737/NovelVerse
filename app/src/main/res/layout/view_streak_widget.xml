<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated into StreakWidgetView (LinearLayout, horizontal) via inflate(..., this, true) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/streak_flame_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="fitCenter"
        android:contentDescription="Streak flame" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/streak_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/error"
            android:text="0" />

        <TextView
            android:id="@+id/streak_label_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="day streak" />

    </LinearLayout>

    <!-- Freeze / shield badge overlaid on flame icon -->
    <ImageView
        android:id="@+id/streak_status_badge"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:visibility="gone"
        android:contentDescription="Streak status badge" />

</merge>
