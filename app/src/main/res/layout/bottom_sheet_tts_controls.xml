<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:background="@drawable/bg_tts_controls_sheet"
     android:orientation="vertical">

    <View
         android:layout_height="4dp"
         android:layout_width="36dp"
         android:layout_marginBottom="16dp"
         android:background="@drawable/bg_drag_handle"
         android:layout_marginTop="10dp"
         android:layout_gravity="center_horizontal" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="4dp"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:paddingHorizontal="20dp">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="11sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="#44FFFFFF"
             android:layout_weight="1"
             android:id="@+id/tts_sheet_chunk_info"
             android:text="— / —" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:background="@drawable/bg_tts_speed_chip"
             android:paddingVertical="4dp"
             android:textSize="10sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="#FFF59E0B"
             android:paddingHorizontal="8dp"
             android:id="@+id/tts_sheet_mode_badge"
             android:text="Offline" />

    </LinearLayout>

    <SeekBar
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="20dp"
         android:max="100"
         android:thumbTint="#0085FF"
         android:progressTint="#0085FF"
         android:paddingHorizontal="20dp"
         android:id="@+id/tts_sheet_seekbar" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="24dp"
         android:gravity="center"
         android:orientation="horizontal">

        <ImageView
             android:layout_height="40dp"
             android:layout_width="40dp"
             android:src="@drawable/ic_close"
             android:layout_marginEnd="10dp"
             android:contentDescription="Stop"
             android:background="@drawable/bg_tts_small_btn"
             android:padding="10dp"
             android:tint="#55FFFFFF"
             android:id="@+id/tts_sheet_btn_stop" />

        <ImageView
             android:layout_height="44dp"
             android:layout_width="44dp"
             android:src="@drawable/ic_arrow_left"
             android:layout_marginEnd="10dp"
             android:contentDescription="Previous"
             android:background="@drawable/bg_tts_small_btn"
             android:padding="11dp"
             android:tint="#AAFFFFFF"
             android:id="@+id/tts_sheet_btn_prev" />

        <ImageView
             android:layout_height="64dp"
             android:layout_width="64dp"
             android:src="@drawable/ic_play"
             android:contentDescription="Play or pause"
             android:background="@drawable/bg_btn_squircle_primary"
             android:elevation="4dp"
             android:padding="16dp"
             android:layout_marginHorizontal="8dp"
             android:tint="#FFFFFF"
             android:id="@+id/tts_sheet_btn_play_pause" />

        <ImageView
             android:layout_height="44dp"
             android:layout_width="44dp"
             android:src="@drawable/ic_arrow_right"
             android:contentDescription="Next"
             android:background="@drawable/bg_tts_small_btn"
             android:padding="11dp"
             android:tint="#AAFFFFFF"
             android:layout_marginStart="10dp"
             android:id="@+id/tts_sheet_btn_next" />

    </LinearLayout>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="8dp"
         android:textSize="9sp"
         android:fontFamily="@font/inter_semibold"
         android:textColor="#44FFFFFF"
         android:letterSpacing="0.14"
         android:paddingHorizontal="20dp"
         android:text="SPEED" />

    <HorizontalScrollView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:scrollbars="none"
         android:layout_marginBottom="20dp"
         android:paddingHorizontal="20dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:orientation="horizontal">

            <TextView
                 android:layout_height="32dp"
                 android:layout_width="wrap_content"
                 android:layout_marginEnd="6dp"
                 android:clickable="true"
                 android:textSize="12sp"
                 android:textColor="#AAFFFFFF"
                 android:focusable="true"
                 android:gravity="center"
                 android:background="@drawable/bg_tts_speed_chip"
                 android:fontFamily="@font/inter_semibold"
                 android:paddingHorizontal="12dp"
                 android:id="@+id/tts_speed_05"
                 android:text="0.5×" />

            <TextView
                 android:layout_height="32dp"
                 android:layout_width="wrap_content"
                 android:layout_marginEnd="6dp"
                 android:clickable="true"
                 android:textSize="12sp"
                 android:textColor="#AAFFFFFF"
                 android:focusable="true"
                 android:gravity="center"
                 android:background="@drawable/bg_tts_speed_chip"
                 android:fontFamily="@font/inter_semibold"
                 android:paddingHorizontal="12dp"
                 android:id="@+id/tts_speed_075"
                 android:text="0.75×" />

            <TextView
                 android:layout_height="32dp"
                 android:layout_width="wrap_content"
                 android:layout_marginEnd="6dp"
                 android:clickable="true"
                 android:textSize="12sp"
                 android:textColor="#FFFFFF"
                 android:focusable="true"
                 android:gravity="center"
                 android:background="@drawable/bg_tts_speed_chip_active"
                 android:fontFamily="@font/inter_semibold"
                 android:paddingHorizontal="12dp"
                 android:id="@+id/tts_speed_1"
                 android:text="1×" />

            <TextView
                 android:layout_height="32dp"
                 android:layout_width="wrap_content"
                 android:layout_marginEnd="6dp"
                 android:clickable="true"
                 android:textSize="12sp"
                 android:textColor="#AAFFFFFF"
                 android:focusable="true"
                 android:gravity="center"
                 android:background="@drawable/bg_tts_speed_chip"
                 android:fontFamily="@font/inter_semibold"
                 android:paddingHorizontal="12dp"
                 android:id="@+id/tts_speed_125"
                 android:text="1.25×" />

            <TextView
                 android:layout_height="32dp"
                 android:layout_width="wrap_content"
                 android:layout_marginEnd="6dp"
                 android:clickable="true"
                 android:textSize="12sp"
                 android:textColor="#AAFFFFFF"
                 android:focusable="true"
                 android:gravity="center"
                 android:background="@drawable/bg_tts_speed_chip"
                 android:fontFamily="@font/inter_semibold"
                 android:paddingHorizontal="12dp"
                 android:id="@+id/tts_speed_15"
                 android:text="1.5×" />

            <TextView
                 android:layout_height="32dp"
                 android:layout_width="wrap_content"
                 android:layout_marginEnd="6dp"
                 android:clickable="true"
                 android:textSize="12sp"
                 android:textColor="#AAFFFFFF"
                 android:focusable="true"
                 android:gravity="center"
                 android:background="@drawable/bg_tts_speed_chip"
                 android:fontFamily="@font/inter_semibold"
                 android:paddingHorizontal="12dp"
                 android:id="@+id/tts_speed_2"
                 android:text="2×" />

            <TextView
                 android:layout_height="32dp"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:background="@drawable/bg_tts_speed_chip"
                 android:clickable="true"
                 android:textSize="12sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="#AAFFFFFF"
                 android:paddingHorizontal="12dp"
                 android:focusable="true"
                 android:id="@+id/tts_speed_3"
                 android:text="3×" />

        </LinearLayout>

    </HorizontalScrollView>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="8dp"
         android:textSize="9sp"
         android:fontFamily="@font/inter_semibold"
         android:textColor="#44FFFFFF"
         android:letterSpacing="0.14"
         android:paddingHorizontal="20dp"
         android:text="VOICE" />

    <LinearLayout
     android:layout_height="60dp"
     android:layout_width="match_parent"
     android:layout_marginBottom="20dp"
     android:gravity="center_vertical"
     android:background="@drawable/bg_tts_voice_row"
     android:clickable="true"
     
     android:layout_marginStart="20dp"         
     android:layout_marginEnd="20dp"       
     android:orientation="horizontal"
     android:paddingHorizontal="14dp"
     android:focusable="true"
     android:id="@+id/tts_sheet_btn_voice">


        <FrameLayout
             android:layout_height="38dp"
             android:layout_width="38dp"
             android:layout_marginEnd="12dp"
             android:background="@drawable/bg_tts_avatar_squircle"
             android:clipToOutline="true"
             android:outlineProvider="background">

            <ImageView
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:scaleType="centerCrop"
                 android:src="@drawable/ic_volume"
                 android:tint="#88FFFFFF"
                 android:id="@+id/tts_sheet_voice_avatar" />

        </FrameLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:orientation="vertical"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="8sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="#33FFFFFF"
                 android:letterSpacing="0.12"
                 android:text="NARRATOR" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="14sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="#EEFFFFFF"
                 android:id="@+id/tts_sheet_voice_name"
                 android:text="Device Default" />

        </LinearLayout>

        <ImageView
             android:layout_height="16dp"
             android:layout_width="16dp"
             android:src="@drawable/ic_chevron_right"
             android:tint="#33FFFFFF" />

    </LinearLayout>

   <LinearLayout
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:layout_marginBottom="32dp"
     android:orientation="horizontal"
     
     android:layout_marginStart="20dp"       
     android:layout_marginEnd="20dp"         
     android:id="@+id/tts_sheet_mode_container">

        <TextView
             android:layout_height="40dp"
             android:layout_width="0dp"
             android:layout_marginEnd="6dp"
             android:gravity="center"
             android:background="@drawable/bg_tts_mode_btn_active"
             android:textSize="12sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="#FFFFFF"
             android:layout_weight="1"
             android:id="@+id/tts_sheet_mode_auto"
             android:text="Auto" />

        <TextView
             android:layout_height="40dp"
             android:layout_width="0dp"
             android:layout_marginEnd="6dp"
             android:gravity="center"
             android:background="@drawable/bg_tts_mode_btn"
             android:textSize="12sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="#55FFFFFF"
             android:layout_weight="1"
             android:id="@+id/tts_sheet_mode_online"
             android:text="Online" />

        <TextView
             android:layout_height="40dp"
             android:layout_width="0dp"
             android:gravity="center"
             android:background="@drawable/bg_tts_mode_btn"
             android:textSize="12sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="#55FFFFFF"
             android:layout_weight="1"
             android:id="@+id/tts_sheet_mode_offline"
             android:text="Offline" />

    </LinearLayout>

</LinearLayout>