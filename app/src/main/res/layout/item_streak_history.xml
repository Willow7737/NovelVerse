<?xml version="1.0" encoding="utf-8"?>
<!--
  Past streak history item.
  Shows: flame icon | streak length | date range | "X days ago" label
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Flame icon with amber background circle -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_home_section_card" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_streak_flame"
                android:scaleType="fitCenter"
                android:contentDescription="Past streak" />

        </FrameLayout>

        <!-- Streak info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_history_length"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 day streak"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_history_dates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Apr 1 – Apr 7"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Time ago -->
        <TextView
            android:id="@+id/tv_history_time_ago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3d ago"
            android:textSize="11sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
