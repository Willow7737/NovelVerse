<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:id="@+id/profile_scroll"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@android:color/transparent"
     android:fillViewport="true">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:paddingBottom="48dp"
         android:paddingTop="16dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:layout_marginHorizontal="14dp"
             android:orientation="vertical"
             android:clipToOutline="true">

            <View
                 android:layout_height="88dp"
                 android:layout_width="match_parent"
                 android:background="@drawable/bg_profile_banner" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="-32dp"
                 android:paddingHorizontal="16dp">

                <FrameLayout
                     android:layout_height="72dp"
                     android:layout_width="72dp"
                     android:background="@drawable/bg_avatar_ring"
                     android:clickable="true"
                     android:elevation="2dp"
                     android:padding="3dp"
                     android:focusable="true">

                    <ImageView
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:visibility="gone"
                         android:scaleType="centerCrop"
                         android:contentDescription="Profile avatar"
                         android:id="@+id/avatar_image" />

                    <TextView
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:gravity="center"
                         android:background="@drawable/bg_avatar_circle"
                         android:textSize="28sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorSurface"
                         android:id="@+id/avatar_initials" />

                </FrameLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:orientation="vertical"
                     android:layout_marginTop="34dp"
                     android:layout_marginStart="12dp"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:ellipsize="end"
                         android:textSize="20sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:maxLines="1"
                         android:id="@+id/display_name_text"
                         android:text="—" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="16sp"
                         android:fontFamily="@font/inter_regular"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="1dp"
                         android:id="@+id/username_text" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:visibility="gone"
                         android:ellipsize="end"
                         android:textSize="15sp"
                         android:fontFamily="@font/inter_regular"
                         android:textColor="?attr/colorOnSurface"
                         android:layout_marginTop="4dp"
                         android:lineSpacingMultiplier="1.3"
                         android:maxLines="2"
                         android:id="@+id/bio_text" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:clickable="true"
                         android:textSize="14sp"
                         android:fontFamily="@font/inter_regular"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:focusable="true"
                         android:id="@+id/email_text" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginHorizontal="8dp"
                 android:orientation="horizontal"
                 android:layout_marginTop="20dp">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="24sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:id="@+id/stat_books_read"
                         android:text="0" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="1dp"
                         android:text="Books" />

                </LinearLayout>

                <View
                     android:layout_height="28dp"
                     android:layout_width="1dp"
                     android:background="@color/divider"
                     android:layout_gravity="center_vertical" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="24sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:id="@+id/stat_followers"
                         android:text="0" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="1dp"
                         android:text="Followers" />

                </LinearLayout>

                <View
                     android:layout_height="28dp"
                     android:layout_width="1dp"
                     android:background="@color/divider"
                     android:layout_gravity="center_vertical" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="24sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:id="@+id/stat_following"
                         android:text="0" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="1dp"
                         android:text="Following" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="18dp"
                 android:gravity="center_vertical"
                 android:layout_marginHorizontal="14dp"
                 android:orientation="horizontal"
                 android:layout_marginTop="14dp">

                <TextView
                     android:layout_height="34dp"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:background="@drawable/bg_btn_surface"
                     android:clickable="true"
                     android:textSize="15sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_weight="1"
                     android:focusable="true"
                     android:id="@+id/btn_edit_profile"
                     android:text="Edit Profile" />

                <View
                     android:layout_height="1dp"
                     android:layout_width="7dp" />

                <LinearLayout
                     android:layout_height="34dp"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:background="@drawable/bg_role_badge"
                     android:clickable="true"
                     android:orientation="horizontal"
                     android:layout_weight="1"
                     android:focusable="true"
                     android:id="@+id/points_container">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="16sp"
                         android:textColor="@color/points"
                         android:text="★ " />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="15sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="@color/points"
                         android:id="@+id/points_text"
                         android:text="0 pts" />

                </LinearLayout>

                <View
                     android:layout_height="1dp"
                     android:layout_width="7dp" />

                <LinearLayout
                     android:layout_height="34dp"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:background="@drawable/bg_btn_surface"
                     android:orientation="horizontal"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorPrimary"
                         android:id="@+id/role_badge"
                         android:text="Reader" />

                    <View
                         android:layout_height="11dp"
                         android:layout_width="1dp"
                         android:background="@color/divider"
                         android:layout_marginHorizontal="6dp" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="@color/warning"
                         android:id="@+id/subscription_badge"
                         android:text="Free" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:layout_marginHorizontal="14dp"
             android:padding="16dp"
             android:orientation="vertical"
             android:layout_marginTop="10dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <ImageView
                     android:layout_height="44dp"
                     android:layout_width="44dp"
                     android:scaleType="fitCenter"
                     android:contentDescription="Level badge"
                     android:id="@+id/level_badge_image" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:orientation="vertical"
                     android:layout_marginStart="10dp"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="16sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorPrimary"
                         android:id="@+id/level_name_text"
                         android:text="Copper Reader  ·  Lv 1" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="@color/text_tertiary"
                         android:layout_marginTop="1dp"
                         android:id="@+id/level_progress_text"
                         android:text="0 / 100 XP" />

                </LinearLayout>

            </LinearLayout>

            <ProgressBar
                 android:layout_height="5dp"
                 android:layout_width="match_parent"
                 android:max="100"
                 style="@android:style/Widget.ProgressBar.Horizontal"
                 android:layout_marginTop="8dp"
                 android:progress="0"
                 android:id="@+id/level_progress_bar" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:visibility="gone"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="10dp"
                 android:id="@+id/streak_row">

                <ImageView
                     android:layout_height="17dp"
                     android:layout_width="17dp"
                     android:src="@drawable/ic_streak_flame"
                     android:contentDescription="Streak" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="@color/warning"
                     android:layout_marginStart="4dp"
                     android:id="@+id/streak_count_text" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_marginStart="3dp"
                     android:text="day streak" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:clickable="true"
             android:layout_marginHorizontal="14dp"
             android:padding="16dp"
             android:orientation="vertical"
             android:layout_marginTop="10dp"
             android:focusable="true"
             android:id="@+id/achievements_preview_card">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginStart="6dp"
                     android:layout_weight="1"
                     android:text="Achievements" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorPrimary"
                     android:id="@+id/achievements_unlocked_count"
                     android:text="0 / 0" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="19sp"
                     android:textColor="@color/text_disabled"
                     android:layout_marginStart="6dp"
                     android:text="›" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="14dp"
                 android:id="@+id/achievement_badges_row">

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Achievement badge"
                         android:id="@+id/achievement_preview_1"
                         android:layout_gravity="center" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Achievement badge"
                         android:id="@+id/achievement_preview_2"
                         android:layout_gravity="center" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Achievement badge"
                         android:id="@+id/achievement_preview_3"
                         android:layout_gravity="center" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Achievement badge"
                         android:id="@+id/achievement_preview_4"
                         android:layout_gravity="center" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Achievement badge"
                         android:id="@+id/achievement_preview_5"
                         android:layout_gravity="center" />

                </FrameLayout>

                <View
                     android:layout_height="1dp"
                     android:layout_width="0dp"
                     android:layout_weight="1" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="15sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="?attr/colorPrimary"
                     android:id="@+id/btn_view_all_achievements"
                     android:text="View All ›" />

            </LinearLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:gravity="center"
                 android:textSize="15sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:layout_marginTop="10dp"
                 android:id="@+id/achievements_empty_hint"
                 android:text="Keep reading to unlock your first achievement!" />

        </LinearLayout>

        <FrameLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:background="@drawable/bg_writer_card"
             android:layout_marginHorizontal="14dp"
             android:padding="18dp"
             android:layout_marginTop="10dp"
             android:id="@+id/become_writer_card">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:gravity="center_vertical"
                     android:orientation="horizontal">

                    <ImageView
                         android:layout_height="17dp"
                         android:layout_width="17dp"
                         android:src="@drawable/ic_write"
                         android:contentDescription="Write"
                         android:tint="?attr/colorPrimary" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="17sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:layout_marginStart="8dp"
                         android:text="Start Writing Today" />

                </LinearLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_marginTop="6dp"
                     android:lineSpacingMultiplier="1.4"
                     android:text="Share your stories with millions of readers. Build a fanbase and earn from your writing." />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:clickable="true"
                     android:textSize="16sp"
                     android:textColor="?attr/colorSurface"
                     android:layout_marginTop="14dp"
                     android:focusable="true"
                     android:background="@drawable/bg_btn_primary"
                     android:paddingVertical="9dp"
                     android:fontFamily="@font/inter_semibold"
                     android:paddingHorizontal="18dp"
                     android:id="@+id/btn_become_writer"
                     android:text="Become a Writer  →" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:background="@drawable/bg_surface_card"
             android:clickable="true"
             android:layout_marginHorizontal="14dp"
             android:padding="16dp"
             android:orientation="vertical"
             android:layout_marginTop="10dp"
             android:focusable="true"
             android:id="@+id/author_stats_section">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="14dp"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginStart="7dp"
                     android:layout_weight="1"
                     android:text="Author Dashboard" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:clickable="true"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="?attr/colorPrimary"
                     android:focusable="true"
                     android:id="@+id/btn_view_dashboard"
                     android:text="View  ›" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal">

                <LinearLayout
                     android:layout_height="68dp"
                     android:layout_width="0dp"
                     android:layout_marginEnd="8dp"
                     android:gravity="center"
                     android:background="@drawable/bg_stat_card"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="19sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="@color/warning"
                         android:id="@+id/stat_total_earnings"
                         android:text="$0.00" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:text="Total Earnings" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="68dp"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:background="@drawable/bg_stat_card"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="19sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="@color/success"
                         android:id="@+id/stat_payout"
                         android:text="$0.00" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:text="Available" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:layout_marginHorizontal="14dp"
             android:orientation="vertical"
             android:layout_marginTop="10dp">

            <LinearLayout
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="?android:attr/selectableItemBackground"
                 android:clickable="true"
                 android:orientation="horizontal"
                 android:paddingHorizontal="16dp"
                 android:focusable="true"
                 android:id="@+id/btn_settings">

                <FrameLayout
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:background="@drawable/bg_btn_squircle_secondary">

                    <ImageView
                         android:layout_height="15dp"
                         android:layout_width="15dp"
                         android:src="@drawable/ic_gear"
                         android:contentDescription="Settings"
                         android:tint="?attr/colorOnSurface"
                         android:layout_gravity="center" />

                </FrameLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="17sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginStart="12dp"
                     android:layout_weight="1"
                     android:text="Settings" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="19sp"
                     android:textColor="@color/text_disabled"
                     android:text="›" />

            </LinearLayout>

            <View
                 android:layout_height="0.5dp"
                 android:layout_width="match_parent"
                 android:background="@color/divider"
                 android:layout_marginStart="58dp" />

            <LinearLayout
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="?android:attr/selectableItemBackground"
                 android:clickable="true"
                 android:orientation="horizontal"
                 android:paddingHorizontal="16dp"
                 android:focusable="true"
                 android:id="@+id/btn_reading_prefs">

                <FrameLayout
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:background="@drawable/bg_btn_squircle_secondary">

                    <ImageView
                         android:layout_height="15dp"
                         android:layout_width="15dp"
                         android:src="@drawable/ic_document"
                         android:contentDescription="Reading Preferences"
                         android:tint="?attr/colorOnSurface"
                         android:layout_gravity="center" />

                </FrameLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="17sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginStart="12dp"
                     android:layout_weight="1"
                     android:text="Reading Preferences" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="19sp"
                     android:textColor="@color/text_disabled"
                     android:text="›" />

            </LinearLayout>

            <View
                 android:layout_height="0.5dp"
                 android:layout_width="match_parent"
                 android:background="@color/divider"
                 android:layout_marginStart="58dp" />

            <LinearLayout
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="?android:attr/selectableItemBackground"
                 android:clickable="true"
                 android:orientation="horizontal"
                 android:paddingHorizontal="16dp"
                 android:focusable="true"
                 android:id="@+id/btn_downloads">

                <FrameLayout
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:background="@drawable/bg_btn_squircle_secondary">

                    <ImageView
                         android:layout_height="15dp"
                         android:layout_width="15dp"
                         android:src="@drawable/ic_download"
                         android:contentDescription="Downloads"
                         android:tint="?attr/colorOnSurface"
                         android:layout_gravity="center" />

                </FrameLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="17sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginStart="12dp"
                     android:layout_weight="1"
                     android:text="Downloads" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="19sp"
                     android:textColor="@color/text_disabled"
                     android:text="›" />

            </LinearLayout>

            <View
                 android:layout_height="0.5dp"
                 android:layout_width="match_parent"
                 android:background="@color/divider"
                 android:layout_marginStart="58dp" />

            <LinearLayout
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="?android:attr/selectableItemBackground"
                 android:clickable="true"
                 android:orientation="horizontal"
                 android:paddingHorizontal="16dp"
                 android:focusable="true"
                 android:id="@+id/btn_help">

                <FrameLayout
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:background="@drawable/bg_btn_squircle_secondary">

                    <ImageView
                         android:layout_height="15dp"
                         android:layout_width="15dp"
                         android:src="@drawable/ic_shield"
                         android:contentDescription="Help"
                         android:tint="?attr/colorOnSurface"
                         android:layout_gravity="center" />

                </FrameLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="17sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginStart="12dp"
                     android:layout_weight="1"
                     android:text="Help and Support" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="19sp"
                     android:textColor="@color/text_disabled"
                     android:text="›" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="52dp"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:background="@drawable/bg_surface_card"
             android:clickable="true"
             android:layout_marginHorizontal="14dp"
             android:orientation="horizontal"
             android:layout_marginTop="10dp"
             android:paddingHorizontal="16dp"
             android:focusable="true"
             android:id="@+id/logout_button">

            <FrameLayout
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:background="@drawable/bg_logout_icon_bg">

                <ImageView
                     android:layout_height="15dp"
                     android:layout_width="15dp"
                     android:src="@drawable/ic_logout"
                     android:contentDescription="Sign out"
                     android:tint="@color/error"
                     android:layout_gravity="center" />

            </FrameLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:textSize="17sp"
                 android:fontFamily="@font/inter_medium"
                 android:textColor="@color/error"
                 android:layout_marginStart="12dp"
                 android:layout_weight="1"
                 android:text="Sign Out" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:alpha="0.45"
                 android:textSize="19sp"
                 android:textColor="@color/error"
                 android:text="›" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>