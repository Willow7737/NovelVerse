<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:fillViewport="true"
     android:fitsSystemWindows="false"
     android:id="@+id/profile_scroll"
     android:overScrollMode="never">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:paddingBottom="80dp"
         android:paddingTop="0dp">

        <FrameLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent">

            <FrameLayout
                 android:layout_height="130dp"
                 android:layout_width="match_parent"
                 android:clickable="true"
                 android:focusable="true"
                 android:id="@+id/banner_container">

                <View
                     android:layout_height="match_parent"
                     android:layout_width="match_parent"
                     android:background="@drawable/bg_profile_banner"
                     android:id="@+id/banner_gradient" />

                <ImageView
                     android:layout_height="match_parent"
                     android:layout_width="match_parent"
                     android:visibility="gone"
                     android:scaleType="centerCrop"
                     android:contentDescription="Cover photo"
                     android:id="@+id/cover_image" />

                <View
                     android:layout_height="80dp"
                     android:layout_width="match_parent"
                     android:background="@drawable/bg_cover_scrim"
                     android:layout_gravity="bottom" />

                <FrameLayout
                     android:layout_height="34dp"
                     android:layout_width="34dp"
                     android:background="@drawable/bg_cover_edit_btn"
                     android:clickable="true"
                     android:elevation="4dp"
                     android:layout_margin="12dp"
                     android:focusable="true"
                     android:id="@+id/btn_edit_cover"
                     android:layout_gravity="bottom|end">

                    <ImageView
                         android:layout_height="16dp"
                         android:layout_width="16dp"
                         android:src="@drawable/ic_camera"
                         android:contentDescription="Edit cover"
                         android:tint="#FFFFFF"
                         android:layout_gravity="center" />

                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                 android:layout_height="88dp"
                 android:layout_width="88dp"
                 android:elevation="6dp"
                 android:layout_marginTop="86dp"
                 android:layout_marginStart="20dp"
                 android:id="@+id/avatar_frame">

                <FrameLayout
                     android:layout_height="match_parent"
                     android:layout_width="match_parent"
                     android:background="@drawable/bg_avatar_ring"
                     android:padding="3dp">

                    <ImageView
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:visibility="gone"
                         android:scaleType="centerCrop"
                         android:contentDescription="Avatar"
                         android:background="@drawable/bg_avatar_circle"
                         android:id="@+id/avatar_image" />

                    <TextView
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:gravity="center"
                         android:background="@drawable/bg_avatar_circle"
                         android:textSize="30sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorSurface"
                         android:id="@+id/avatar_initials" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="22dp"
                     android:layout_width="22dp"
                     android:layout_marginBottom="3dp"
                     android:layout_marginEnd="3dp"
                     android:background="@drawable/bg_status_ring"
                     android:elevation="7dp"
                     android:padding="3dp"
                     android:id="@+id/status_bubble_ring"
                     android:layout_gravity="bottom|end">

                    <View
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:background="@drawable/bg_status_offline"
                         android:id="@+id/status_bubble_dot" />

                </FrameLayout>

            </FrameLayout>

        </FrameLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:paddingHorizontal="20dp"
             android:paddingTop="10dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:ellipsize="end"
                 android:textSize="22sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="?attr/colorOnSurface"
                 android:maxLines="1"
                 android:id="@+id/display_name_text"
                 android:text="—" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="14sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:layout_marginTop="2dp"
                 android:id="@+id/username_text" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:ellipsize="end"
                 android:textSize="14sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:layout_marginTop="6dp"
                 android:lineSpacingMultiplier="1.35"
                 android:maxLines="3"
                 android:id="@+id/bio_text" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="horizontal"
             android:layout_marginTop="16dp"
             android:paddingHorizontal="10dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:clickable="true"
                 android:paddingVertical="8dp"
                 android:orientation="vertical"
                 android:layout_weight="1"
                 android:focusable="true"
                 android:id="@+id/stat_books_container">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="22sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:id="@+id/stat_books_read"
                     android:text="0" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="12sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_marginTop="1dp"
                     android:text="Books" />

            </LinearLayout>

            <View
                 android:layout_height="28dp"
                 android:layout_width="1dp"
                 android:background="@color/divider"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:clickable="true"
                 android:paddingVertical="8dp"
                 android:orientation="vertical"
                 android:layout_weight="1"
                 android:focusable="true"
                 android:id="@+id/stat_followers_container">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="22sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:id="@+id/stat_followers"
                     android:text="0" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="12sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_marginTop="1dp"
                     android:text="Followers" />

            </LinearLayout>

            <View
                 android:layout_height="28dp"
                 android:layout_width="1dp"
                 android:background="@color/divider"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:clickable="true"
                 android:paddingVertical="8dp"
                 android:orientation="vertical"
                 android:layout_weight="1"
                 android:focusable="true"
                 android:id="@+id/stat_following_container">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="22sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:id="@+id/stat_following"
                     android:text="0" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="12sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_marginTop="1dp"
                     android:text="Following" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:layout_marginHorizontal="16dp"
             android:orientation="horizontal"
             android:layout_marginTop="14dp">

            <TextView
                 android:layout_height="40dp"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:background="@drawable/bg_btn_surface"
                 android:clickable="true"
                 android:textSize="14sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="?attr/colorOnSurface"
                 android:layout_weight="1"
                 android:focusable="true"
                 android:id="@+id/btn_edit_profile"
                 android:text="Edit Profile" />

            <View
                 android:layout_height="1dp"
                 android:layout_width="8dp" />

            <LinearLayout
                 android:layout_height="40dp"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:background="@drawable/bg_role_badge"
                 android:clickable="true"
                 android:orientation="horizontal"
                 android:layout_weight="1"
                 android:focusable="true"
                 android:id="@+id/points_container">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="14sp"
                     android:textColor="@color/points"
                     android:text="★ " />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="13sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="@color/points"
                     android:id="@+id/points_text"
                     android:text="0 pts" />

            </LinearLayout>

            <View
                 android:layout_height="1dp"
                 android:layout_width="8dp" />

            <LinearLayout
                 android:layout_height="40dp"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:background="@drawable/bg_btn_surface"
                 android:orientation="horizontal"
                 android:layout_weight="1">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="13sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorPrimary"
                     android:id="@+id/role_badge"
                     android:text="Reader" />

                <View
                     android:layout_height="11dp"
                     android:layout_width="1dp"
                     android:background="@color/divider"
                     android:layout_marginHorizontal="6dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="13sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="@color/warning"
                     android:id="@+id/subscription_badge"
                     android:text="Free" />

            </LinearLayout>

        </LinearLayout>

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:background="@color/divider"
             android:alpha="0.5"
             android:layout_marginTop="18dp" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:layout_marginHorizontal="14dp"
             android:padding="18dp"
             android:orientation="vertical"
             android:layout_marginTop="14dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <ImageView
                     android:layout_height="56dp"
                     android:layout_width="56dp"
                     android:scaleType="fitCenter"
                     android:contentDescription="Level badge"
                     android:id="@+id/level_badge_image" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:orientation="vertical"
                     android:layout_marginStart="14dp"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="15sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorPrimary"
                         android:id="@+id/level_name_text"
                         android:text="Copper Reader  ·  Lv 1" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:id="@+id/level_progress_text"
                         android:text="0 / 100 XP" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:visibility="gone"
                     android:gravity="center_vertical"
                     android:background="@drawable/bg_stat_card"
                     android:paddingVertical="6dp"
                     android:orientation="horizontal"
                     android:paddingHorizontal="10dp"
                     android:id="@+id/streak_row">

                    <ImageView
                         android:layout_height="16dp"
                         android:layout_width="16dp"
                         android:src="@drawable/ic_streak_flame"
                         android:contentDescription="Streak" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="13sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="@color/warning"
                         android:layout_marginStart="4dp"
                         android:id="@+id/streak_count_text" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginStart="2dp"
                         android:text="d" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                 android:layout_height="8dp"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:layout_marginTop="14dp"
                 android:id="@+id/xp_segments_container">

            </LinearLayout>

            <ProgressBar
                 android:layout_height="5dp"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:max="100"
                 style="@android:style/Widget.ProgressBar.Horizontal"
                 android:progress="0"
                 android:id="@+id/level_progress_bar" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:clickable="true"
             android:layout_marginHorizontal="14dp"
             android:padding="18dp"
             android:orientation="vertical"
             android:layout_marginTop="10dp"
             android:focusable="true"
             android:id="@+id/achievements_preview_card">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_weight="1"
                     android:text="Achievements" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="14sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="@color/accent_gold"
                     android:id="@+id/achievements_unlocked_count"
                     android:text="0 / 0" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="18sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:text=" ›" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="14dp"
                 android:id="@+id/achievement_badges_row">

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Badge"
                         android:id="@+id/achievement_preview_1"
                         android:layout_gravity="center" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Badge"
                         android:id="@+id/achievement_preview_2"
                         android:layout_gravity="center" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Badge"
                         android:id="@+id/achievement_preview_3"
                         android:layout_gravity="center" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Badge"
                         android:id="@+id/achievement_preview_4"
                         android:layout_gravity="center" />

                </FrameLayout>

                <FrameLayout
                     android:layout_height="46dp"
                     android:layout_width="46dp"
                     android:background="@drawable/bg_stat_card">

                    <ImageView
                         android:layout_height="32dp"
                         android:layout_width="32dp"
                         android:visibility="gone"
                         android:scaleType="fitCenter"
                         android:contentDescription="Badge"
                         android:id="@+id/achievement_preview_5"
                         android:layout_gravity="center" />

                </FrameLayout>

                <View
                     android:layout_height="1dp"
                     android:layout_width="0dp"
                     android:layout_weight="1" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="13sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="?attr/colorPrimary"
                     android:id="@+id/btn_view_all_achievements"
                     android:text="View All ›" />

            </LinearLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:gravity="center"
                 android:textSize="14sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:layout_marginTop="12dp"
                 android:id="@+id/achievements_empty_hint"
                 android:text="Keep reading to unlock your first badge!" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:background="@drawable/bg_surface_card"
             android:clickable="true"
             android:layout_marginHorizontal="14dp"
             android:padding="18dp"
             android:orientation="vertical"
             android:layout_marginTop="10dp"
             android:focusable="true"
             android:id="@+id/author_stats_section">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="14dp"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_weight="1"
                     android:text="Author Dashboard" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:clickable="true"
                     android:textSize="14sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="?attr/colorPrimary"
                     android:focusable="true"
                     android:id="@+id/btn_view_dashboard"
                     android:text="View ›" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal">

                <LinearLayout
                     android:layout_height="68dp"
                     android:layout_width="0dp"
                     android:layout_marginEnd="8dp"
                     android:gravity="center"
                     android:background="@drawable/bg_stat_card"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="20sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:id="@+id/stat_total_earnings"
                         android:text="$0.00" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:text="Lifetime" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="68dp"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:background="@drawable/bg_stat_card"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="20sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="@color/success"
                         android:id="@+id/stat_payout"
                         android:text="$0.00" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:text="Ready to withdraw" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <FrameLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:background="@drawable/bg_writer_card"
             android:layout_marginHorizontal="14dp"
             android:padding="18dp"
             android:layout_marginTop="10dp"
             android:id="@+id/become_writer_card">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:gravity="center_vertical"
                     android:orientation="horizontal">

                    <ImageView
                         android:layout_height="17dp"
                         android:layout_width="17dp"
                         android:src="@drawable/ic_write"
                         android:contentDescription="Write"
                         android:tint="?attr/colorPrimary" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="17sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:layout_marginStart="8dp"
                         android:text="Start Writing Today" />

                </LinearLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="15sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_marginTop="6dp"
                     android:lineSpacingMultiplier="1.4"
                     android:text="Share your stories with millions of readers. Build a fanbase and earn from your writing." />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:clickable="true"
                     android:textSize="15sp"
                     android:textColor="?attr/colorSurface"
                     android:layout_marginTop="14dp"
                     android:focusable="true"
                     android:background="@drawable/bg_btn_primary"
                     android:paddingVertical="9dp"
                     android:fontFamily="@font/inter_semibold"
                     android:paddingHorizontal="18dp"
                     android:id="@+id/btn_become_writer"
                     android:text="Become a Writer  →" />

            </LinearLayout>

        </FrameLayout>

        <HorizontalScrollView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:scrollbars="none"
             android:clipToPadding="false"
             android:layout_marginTop="14dp"
             android:paddingHorizontal="14dp"
             android:overScrollMode="never">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:orientation="horizontal">

                <LinearLayout
                     android:layout_height="40dp"
                     android:layout_width="wrap_content"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_quick_action_chip"
                     android:gravity="center_vertical"
                     android:clickable="true"
                     android:orientation="horizontal"
                     android:paddingHorizontal="14dp"
                     android:focusable="true"
                     android:id="@+id/quick_share">

                    <ImageView
                         android:layout_height="15dp"
                         android:layout_width="15dp"
                         android:src="@drawable/ic_share"
                         android:contentDescription="Share"
                         android:tint="?attr/colorOnSurface" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:fontFamily="@font/inter_medium"
                         android:textColor="?attr/colorOnSurface"
                         android:layout_marginStart="6dp"
                         android:text="Share" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="40dp"
                     android:layout_width="wrap_content"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_quick_action_chip"
                     android:gravity="center_vertical"
                     android:clickable="true"
                     android:orientation="horizontal"
                     android:paddingHorizontal="14dp"
                     android:focusable="true"
                     android:id="@+id/quick_copy_link">

                    <ImageView
                         android:layout_height="15dp"
                         android:layout_width="15dp"
                         android:src="@drawable/ic_link"
                         android:contentDescription="Copy link"
                         android:tint="?attr/colorOnSurface" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:fontFamily="@font/inter_medium"
                         android:textColor="?attr/colorOnSurface"
                         android:layout_marginStart="6dp"
                         android:text="Copy Link" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="40dp"
                     android:layout_width="wrap_content"
                     android:layout_marginEnd="8dp"
                     android:background="@drawable/bg_quick_action_chip"
                     android:gravity="center_vertical"
                     android:clickable="true"
                     android:orientation="horizontal"
                     android:paddingHorizontal="14dp"
                     android:focusable="true"
                     android:id="@+id/quick_settings">

                    <ImageView
                         android:layout_height="15dp"
                         android:layout_width="15dp"
                         android:src="@drawable/ic_gear"
                         android:contentDescription="Settings"
                         android:tint="?attr/colorOnSurface" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:fontFamily="@font/inter_medium"
                         android:textColor="?attr/colorOnSurface"
                         android:layout_marginStart="6dp"
                         android:text="Settings" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="40dp"
                     android:layout_width="wrap_content"
                     android:background="@drawable/bg_quick_action_premium"
                     android:gravity="center_vertical"
                     android:clickable="true"
                     android:elevation="3dp"
                     android:orientation="horizontal"
                     android:paddingHorizontal="14dp"
                     android:focusable="true"
                     android:id="@+id/quick_premium">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="13sp"
                         android:textColor="#FFFFFF"
                         android:text="⭐ " />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="#FFFFFF"
                         android:text="Get Premium" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:layout_marginHorizontal="14dp"
             android:orientation="vertical"
             android:layout_marginTop="14dp">

            <LinearLayout
                 android:layout_height="54dp"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:background="?android:attr/selectableItemBackground"
                 android:clickable="true"
                 android:orientation="horizontal"
                 android:paddingHorizontal="16dp"
                 android:focusable="true"
                 android:id="@+id/btn_settings">

                <FrameLayout
                     android:layout_height="30dp"
                     android:layout_width="30dp"
                     android:background="@drawable/bg_btn_squircle_secondary">

                    <ImageView
                         android:layout_height="15dp"
                         android:layout_width="15dp"
                         android:src="@drawable/ic_gear"
                         android:contentDescription="Settings"
                         android:tint="?attr/colorOnSurface"
                         android:layout_gravity="center" />

                </FrameLayout>

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginStart="12dp"
                     android:layout_weight="1"
                     android:text="Settings" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="20sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:text="›" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="54dp"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:gravity="center_vertical"
             android:clickable="true"
             android:layout_marginHorizontal="14dp"
             android:orientation="horizontal"
             android:layout_marginTop="10dp"
             android:paddingHorizontal="16dp"
             android:focusable="true"
             android:id="@+id/logout_button">

            <FrameLayout
                 android:layout_height="30dp"
                 android:layout_width="30dp"
                 android:background="@drawable/bg_logout_icon_bg">

                <ImageView
                     android:layout_height="15dp"
                     android:layout_width="15dp"
                     android:src="@drawable/ic_logout"
                     android:contentDescription="Sign out"
                     android:tint="@color/error"
                     android:layout_gravity="center" />

            </FrameLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:textSize="16sp"
                 android:fontFamily="@font/inter_medium"
                 android:textColor="@color/error"
                 android:layout_marginStart="12dp"
                 android:layout_weight="1"
                 android:text="Sign Out" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:alpha="0.4"
                 android:textSize="20sp"
                 android:textColor="@color/error"
                 android:text="›" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>