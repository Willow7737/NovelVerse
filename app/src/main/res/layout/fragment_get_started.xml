<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:fillViewport="true">

    <LinearLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:gravity="center_horizontal"
         android:padding="16dp"
         android:layout_gravity="center"
         android:orientation="vertical">

        <ImageView
            android:id="@+id/hero_image"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/onboarding_hero"
            android:minHeight="140dp"
            android:padding="24dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_get_started_bg" />

        <ImageView
             android:layout_height="wrap_content"
             android:layout_width="180dp"
             android:adjustViewBounds="true"
             android:src="@drawable/logo_text"
             android:contentDescription="@string/app_name"
             android:id="@+id/logo_image" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:gravity="center"
             android:textSize="16sp"
             android:fontFamily="@font/inter_regular"
             android:textColor="@color/onboarding_text_secondary"
             android:layout_marginTop="12dp"
             android:text="@string/onboarding_tagline" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 app:iconSize="24dp"
                 app:backgroundTint="@color/white"
                 app:strokeColor="@color/onboarding_border"
                 android:textSize="16sp"
                 app:iconTint="@null"
                 android:textColor="@color/onboarding_text_primary"
                 android:paddingStart="16dp"
                 app:iconPadding="8dp"
                 app:icon="@drawable/ic_google"
                 android:paddingEnd="16dp"
                 android:gravity="center"
                 android:fontFamily="@font/inter_medium"
                 app:cornerRadius="12dp"
                 app:strokeWidth="1dp"
                 style="@style/Widget.Material3.Button.OutlinedButton"
                 android:id="@+id/btn_google"
                 android:text="@string/continue_with_google"
                 app:iconGravity="start" />

            <com.google.android.material.button.MaterialButton
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 app:iconSize="24dp"
                 app:backgroundTint="@color/white"
                 app:strokeColor="@color/onboarding_border"
                 android:textSize="16sp"
                 app:iconTint="@null"
                 android:textColor="@color/onboarding_text_primary"
                 android:paddingStart="16dp"
                 app:iconPadding="8dp"
                 android:layout_marginTop="8dp"
                 app:icon="@drawable/ic_apple"
                 android:paddingEnd="16dp"
                 android:gravity="center"
                android:visibility="gone"
                 android:fontFamily="@font/inter_medium"
                 app:cornerRadius="12dp"
                 app:strokeWidth="1dp"
                 style="@style/Widget.Material3.Button.OutlinedButton"
                 android:id="@+id/btn_apple"
                 android:text="@string/continue_with_apple"
                 app:iconGravity="start" />

            <com.google.android.material.button.MaterialButton
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 app:iconSize="24dp"
                 app:backgroundTint="@color/white"
                 app:strokeColor="@color/onboarding_border"
                 android:textSize="16sp"
                 app:iconTint="@null"
                 android:visibility="gone"
                 android:textColor="@color/onboarding_text_primary"
                 android:paddingStart="16dp"
                 app:iconPadding="8dp"
                 android:layout_marginTop="8dp"
                 app:icon="@drawable/ic_facebook"
                 android:paddingEnd="16dp"
                 android:gravity="center"
                 android:fontFamily="@font/inter_medium"
                 app:cornerRadius="12dp"
                 app:strokeWidth="1dp"
                 style="@style/Widget.Material3.Button.OutlinedButton"
                 android:id="@+id/btn_facebook"
                 android:text="@string/continue_with_facebook"
                 app:iconGravity="start" />

            <com.google.android.material.button.MaterialButton
                 android:layout_height="52dp"
                 android:layout_width="match_parent"
                 app:iconSize="24dp"
                 app:backgroundTint="@color/white"
                 app:strokeColor="@color/onboarding_border"
                 android:textSize="16sp"
                 app:iconTint="@null"
                 android:textColor="@color/onboarding_text_primary"
                 android:paddingStart="16dp"
                 app:iconPadding="12dp"
                 android:layout_marginTop="8dp"
                 app:icon="@drawable/ic_mail_filled"
                 android:paddingEnd="16dp"
                 android:gravity="center"
                 android:fontFamily="@font/inter_medium"
                 app:cornerRadius="12dp"
                 app:strokeWidth="1dp"
                 style="@style/Widget.Material3.Button.OutlinedButton"
                 android:id="@+id/btn_email"
                 android:text="@string/sign_up_with_email"
                 app:iconGravity="start" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:layout_marginHorizontal="16dp"
             android:orientation="horizontal"
             android:layout_marginTop="20dp">

            <View
                 android:layout_height="1dp"
                 android:layout_width="0dp"
                 android:background="@color/divider"
                 android:layout_weight="1" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginHorizontal="12dp"
                 android:textSize="14sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="@color/onboarding_text_tertiary"
                 android:text="@string/or" />

            <View
                 android:layout_height="1dp"
                 android:layout_width="0dp"
                 android:background="@color/divider"
                 android:layout_weight="1" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
             android:layout_height="50dp"
             android:layout_width="match_parent"
             app:backgroundTint="@color/button_blue"
             android:textSize="16sp"
             android:textColor="@color/white"
             android:layout_marginTop="16dp"
             android:fontFamily="@font/inter_semibold"
             app:cornerRadius="16dp"
             android:id="@+id/btn_login"
             android:text="@string/login" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:clickable="true"
             android:padding="8dp"
             android:textSize="14sp"
             android:textColor="@color/onboarding_text_tertiary"
             android:layout_marginTop="12dp"
             android:focusable="true"
             android:layout_gravity="center_horizontal"
             android:background="?attr/selectableItemBackground"
             android:fontFamily="@font/inter_medium"
             android:id="@+id/btn_guest"
             android:text="@string/continue_as_guest" />

    </LinearLayout>

</LinearLayout>