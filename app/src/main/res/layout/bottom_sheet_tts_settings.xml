<?xml version="1.0" encoding="utf-8"?>
<!--
  bottom_sheet_tts_settings.xml  —  TTS Settings panel
  bg-surface=#14141B, accent=#6366F1
  Sections: Voice row | Speed (slider + chips) | Sleep timer | Text size | Toggles
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tts_controls_sheet"
    android:orientation="vertical">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- ── Sheet title ───────────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:text="Playback Settings"
        android:textSize="16sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#FAFAFA" />

    <!-- ════════════════ VOICE ROW ═══════════════════════════════ -->
    <LinearLayout
        android:id="@+id/tts_settings_voice_row"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_tts_voice_row"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="14dp"
        android:orientation="horizontal">

        <!-- 36dp avatar -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_tts_avatar_squircle"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <ImageView
                android:id="@+id/tts_settings_voice_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:padding="8dp"
                android:src="@drawable/ic_waveform"
                android:tint="#A1A1AA" />

        </FrameLayout>

        <!-- Name + lang -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tts_settings_voice_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aria"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#FAFAFA" />

            <TextView
                android:id="@+id/tts_settings_voice_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="en-US · Neural"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#71717A" />

        </LinearLayout>

        <!-- Chevron right -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#52525B" />

    </LinearLayout>

    <!-- ════════════════ SPEED ═══════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:text="SPEED"
        android:textSize="10sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#52525B"
        android:letterSpacing="0.12" />

    <!-- Speed display label (updates live) -->
    <TextView
        android:id="@+id/tts_settings_speed_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="6dp"
        android:text="1.0×"
        android:textSize="22sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#6366F1"
        android:gravity="center" />

    <!-- Continuous speed slider 0.5–3.0× -->
    <SeekBar
        android:id="@+id/tts_settings_speed_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="20"
        android:thumbTint="#6366F1"
        android:progressTint="#6366F1"
        android:progressBackgroundTint="#1E1E2A"
        android:splitTrack="false"
        android:thumb="@drawable/bg_tts_progress_thumb" />

    <!-- Speed preset chips: 0.8 / 1 / 1.25 / 1.5 / 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tts_speed_08"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="0.8×"
            android:textSize="12sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#A1A1AA"
            android:background="@drawable/bg_tts_speed_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tts_speed_1"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="1×"
            android:textSize="12sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tts_speed_chip_active"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tts_speed_125"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="1.25×"
            android:textSize="12sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#A1A1AA"
            android:background="@drawable/bg_tts_speed_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tts_speed_15"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="1.5×"
            android:textSize="12sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#A1A1AA"
            android:background="@drawable/bg_tts_speed_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tts_speed_2"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2×"
            android:textSize="12sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#A1A1AA"
            android:background="@drawable/bg_tts_speed_chip"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ════════════════ SLEEP TIMER ═════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:text="SLEEP TIMER"
        android:textSize="10sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#52525B"
        android:letterSpacing="0.12" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="24dp"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tts_sleep_off"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:text="Off"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_tts_speed_chip_active"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tts_sleep_15"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:text="15m"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#A1A1AA"
                android:background="@drawable/bg_tts_speed_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tts_sleep_30"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:text="30m"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#A1A1AA"
                android:background="@drawable/bg_tts_speed_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tts_sleep_45"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:text="45m"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#A1A1AA"
                android:background="@drawable/bg_tts_speed_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tts_sleep_end_chap"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:text="End of chapter"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#A1A1AA"
                android:background="@drawable/bg_tts_speed_chip"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- ════════════════ TEXT SIZE ═══════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:text="TEXT SIZE"
        android:textSize="10sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#52525B"
        android:letterSpacing="0.12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tts_text_size_14"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="A"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#A1A1AA"
            android:background="@drawable/bg_tts_speed_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tts_text_size_16"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="A"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tts_speed_chip_active"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tts_text_size_18"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="A"
            android:textSize="17sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#A1A1AA"
            android:background="@drawable/bg_tts_speed_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tts_text_size_20"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="A"
            android:textSize="19sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#A1A1AA"
            android:background="@drawable/bg_tts_speed_chip"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ════════════════ TOGGLES ═════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="4dp"
        android:text="DISPLAY"
        android:textSize="10sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="#52525B"
        android:letterSpacing="0.12" />

    <!-- Auto-scroll toggle -->
    <LinearLayout
        android:id="@+id/tts_toggle_auto_scroll_row"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Auto-scroll"
            android:textSize="14sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#FAFAFA" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/tts_toggle_auto_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

    <!-- Highlight toggle (3-state) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sentence highlight"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#FAFAFA" />

            <TextView
                android:id="@+id/tts_highlight_state_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color + dim"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#71717A" />

        </LinearLayout>

        <!-- 3-state: Off / Dim / Color+Dim — displayed as cycling chips -->
        <TextView
            android:id="@+id/tts_highlight_cycle_btn"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:text="Color + dim"
            android:textSize="12sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tts_speed_chip_active"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Reduce motion toggle -->
    <LinearLayout
        android:id="@+id/tts_toggle_reduce_motion_row"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reduce motion"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#FAFAFA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Static text, no pulse"
                android:textSize="11sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#71717A" />

        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/tts_toggle_reduce_motion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>

    <!-- Bottom safe area spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</LinearLayout>
