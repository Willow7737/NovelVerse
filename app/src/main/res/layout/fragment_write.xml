<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:id="@+id/write_scroll"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="?attr/colorSurface">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:paddingBottom="100dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_writer_card"
             android:layout_marginHorizontal="14dp"
             android:padding="20dp"
             android:orientation="vertical"
             android:layout_marginTop="14dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="16sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:letterSpacing="0.10"
                 android:text="Author Dashboard" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="6dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="36sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_weight="1"
                     android:id="@+id/txt_total_earnings"
                     android:text="$0.00" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:background="@drawable/bg_btn_surface"
                     android:paddingVertical="10dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="@color/primary"
                     android:paddingHorizontal="16dp"
                     android:id="@+id/btn_new_novel"
                     android:text="+ New Novel" />

            </LinearLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="18sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:layout_marginTop="2dp"
                 android:text="Total Earnings" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:layout_marginTop="18dp">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="20sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:id="@+id/txt_total_works"
                         android:text="0" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="16sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:text="Works" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="20sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:id="@+id/txt_total_views"
                         android:text="0" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="16sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:text="Total Views" />

                </LinearLayout>

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="20sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:id="@+id/txt_available_payout"
                         android:text="$0.00" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="16sp"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:text="Available" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_marginHorizontal="14dp"
             android:orientation="horizontal"
             android:layout_marginTop="12dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:layout_marginEnd="5dp"
                 android:gravity="center"
                 android:background="@drawable/bg_surface_card"
                 android:elevation="1dp"
                 android:paddingVertical="16dp"
                 android:orientation="vertical"
                 android:layout_weight="1"
                 android:id="@+id/action_chapters">

                <ImageView
                     android:layout_height="24dp"
                     android:layout_width="24dp"
                     android:src="@drawable/ic_write"
                     android:contentDescription="Add Chapter"
                     android:tint="@color/primary" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textSize="14sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="@color/text_primary"
                     android:layout_marginTop="6dp"
                     android:text="Add Chapter" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:layout_marginEnd="5dp"
                 android:gravity="center"
                 android:background="@drawable/bg_surface_card"
                 android:elevation="1dp"
                 android:paddingVertical="16dp"
                 android:orientation="vertical"
                 android:layout_weight="1"
                 android:id="@+id/action_analytics">

                <ImageView
                     android:layout_height="24dp"
                     android:layout_width="24dp"
                     android:src="@drawable/ic_bar_chart"
                     android:contentDescription="Analytics"
                     android:tint="@color/secondary" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textSize="14sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="@color/text_primary"
                     android:layout_marginTop="6dp"
                     android:text="Analytics" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:gravity="center"
                 android:background="@drawable/bg_surface_card"
                 android:elevation="1dp"
                 android:paddingVertical="16dp"
                 android:orientation="vertical"
                 android:layout_weight="1"
                 android:id="@+id/action_payout">

                <ImageView
                     android:layout_height="24dp"
                     android:layout_width="24dp"
                     android:src="@drawable/ic_wallet"
                     android:contentDescription="Payout"
                     android:tint="@color/accent" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textSize="14sp"
                     android:fontFamily="@font/inter_medium"
                     android:textColor="@color/text_primary"
                     android:layout_marginTop="6dp"
                     android:text="Payout" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:orientation="horizontal"
             android:paddingBottom="8dp"
             android:paddingHorizontal="14dp"
             android:paddingTop="22dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="0dp"
                 android:textSize="18sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="@color/text_primary"
                 android:layout_weight="1"
                 android:text="My Works" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="16sp"
                 android:fontFamily="@font/inter_medium"
                 android:textColor="@color/primary"
                 android:id="@+id/btn_see_all_novels"
                 android:text="See All  ›" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:paddingHorizontal="14dp"
             android:id="@+id/novels_container">

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:gravity="center"
             android:paddingVertical="32dp"
             android:orientation="vertical"
             android:paddingHorizontal="40dp"
             android:id="@+id/empty_novels">

            <ImageView
                 android:layout_height="56dp"
                 android:layout_width="56dp"
                 android:src="@drawable/ic_document"
                 android:contentDescription="No novels"
                 android:tint="@color/text_tertiary" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:textSize="18sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="@color/text_primary"
                 android:layout_marginTop="12dp"
                 android:text="Your story starts here" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center"
                 android:textSize="16sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="@color/text_secondary"
                 android:layout_marginTop="8dp"
                 android:lineSpacingMultiplier="1.4"
                 android:text="You haven't published any works yet. Hit New Novel to begin your writing journey." />

            <TextView
                 android:layout_height="48dp"
                 android:layout_width="wrap_content"
                 android:gravity="center"
                 android:background="@drawable/bg_btn_primary"
                 android:textSize="16sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="?attr/colorOnSurface"
                 android:layout_marginTop="20dp"
                 android:paddingHorizontal="28dp"
                 android:id="@+id/btn_empty_new_novel"
                 android:text="+ Create Your First Novel" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:background="@drawable/bg_surface_card"
             android:elevation="1dp"
             android:layout_marginHorizontal="14dp"
             android:padding="16dp"
             android:orientation="vertical"
             android:layout_marginTop="20dp"
             android:id="@+id/tips_section">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginBottom="10dp"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <ImageView
                     android:layout_height="18dp"
                     android:layout_width="18dp"
                     android:src="@drawable/ic_star"
                     android:contentDescription="Tips"
                     android:tint="@color/warning" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="@color/text_primary"
                     android:layout_marginStart="6dp"
                     android:text="Writer Tips" />

            </LinearLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:paddingVertical="4dp"
                 android:textSize="16sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="@color/text_secondary"
                 android:lineSpacingMultiplier="1.3"
                 android:text="✓  Consistent updates keep readers hooked — aim for weekly chapters." />

            <View
                 android:layout_height="0.5dp"
                 android:layout_width="match_parent"
                 android:layout_marginVertical="4dp"
                 android:background="@color/divider" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:paddingVertical="4dp"
                 android:textSize="16sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="@color/text_secondary"
                 android:lineSpacingMultiplier="1.3"
                 android:text="✓  The first chapter is your hook — make it unforgettable." />

            <View
                 android:layout_height="0.5dp"
                 android:layout_width="match_parent"
                 android:layout_marginVertical="4dp"
                 android:background="@color/divider" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:paddingVertical="4dp"
                 android:textSize="16sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="@color/text_secondary"
                 android:lineSpacingMultiplier="1.3"
                 android:text="✓  Reply to comments — readers who feel heard become loyal fans." />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>