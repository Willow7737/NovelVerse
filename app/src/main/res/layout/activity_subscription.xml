<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="?attr/colorSurface"
     android:orientation="vertical">

    <LinearLayout
         android:layout_height="60dp"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:background="?attr/colorSurface"
         android:orientation="horizontal"
         android:paddingHorizontal="12dp">

        <ImageView
             android:layout_height="44dp"
             android:layout_width="44dp"
             android:src="@drawable/ic_back"
             android:contentDescription="Back"
             android:background="@drawable/bg_icon_btn_white"
             android:padding="10dp"
             android:tint="?attr/colorOnSurfaceVariant"
             android:id="@+id/btn_back" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="20sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="?attr/colorOnSurface"
             android:layout_marginStart="12dp"
             android:layout_weight="1"
             android:text="Subscription" />

    </LinearLayout>
    <!-- Bluesky hairline divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />


    <androidx.core.widget.NestedScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:paddingBottom="40dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center"
                 android:background="@drawable/bg_writer_card"
                 android:paddingVertical="32dp"
                 android:orientation="vertical"
                 android:paddingHorizontal="20dp">

                <ImageView
                     android:layout_height="56dp"
                     android:layout_width="56dp"
                     android:src="@drawable/ic_crown"
                     android:contentDescription="Premium"
                     android:tint="?attr/colorSurface" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="28sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:layout_marginTop="12dp"
                     android:text="Go Premium" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textSize="15sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="#DDFFFFFF"
                     android:layout_marginTop="6dp"
                     android:text="Unlimited reading. No ads. Early access." />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:background="@drawable/bg_surface_card"
                 android:elevation="2dp"
                 android:padding="4dp"
                 android:orientation="horizontal"
                 android:layout_marginTop="20dp"
                 android:layout_gravity="center_horizontal">

                <TextView
                     android:layout_height="40dp"
                     android:layout_width="120dp"
                     android:gravity="center"
                     android:background="@drawable/bg_btn_primary"
                     android:textSize="15sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorSurface"
                     android:id="@+id/tab_monthly"
                     android:text="Monthly" />

                <TextView
                     android:layout_height="40dp"
                     android:layout_width="120dp"
                     android:gravity="center"
                     android:textSize="15sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="@color/text_secondary"
                     android:id="@+id/tab_annual"
                     android:text="Annual  -30%" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:layout_marginTop="16dp"
                 android:paddingHorizontal="14dp"
                 android:id="@+id/plans_container">

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:background="@drawable/bg_surface_card"
                 android:elevation="1dp"
                 android:layout_marginHorizontal="14dp"
                 android:padding="16dp"
                 android:orientation="vertical"
                 android:layout_marginTop="14dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_marginBottom="12dp"
                     android:textSize="17sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="@color/text_primary"
                     android:text="What you get" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:orientation="vertical"
                     android:id="@+id/benefits_container">

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>