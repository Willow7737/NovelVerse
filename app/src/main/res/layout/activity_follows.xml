<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@android:color/transparent"
     android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
         android:layout_height="?attr/actionBarSize"
         android:layout_width="match_parent"
         android:background="@drawable/bg_app_main"
         app:title="@string/follows_title"
         app:navigationIcon="@drawable/ic_arrow_left"
         app:navigationIconTint="@color/icon_primary"
         android:id="@+id/toolbar" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@android:color/transparent"
         android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
             android:layout_height="48dp"
             android:layout_width="match_parent"
             app:tabMode="scrollable"
             app:tabIndicatorColor="@color/primary"
             app:tabTextColor="?attr/colorOnSurfaceVariant"
             android:paddingStart="8dp"
             app:tabSelectedTextColor="@color/primary"
             android:paddingEnd="8dp"
             android:background="@drawable/bg_app_main"
             app:tabGravity="start"
             app:tabTextAppearance="@style/TextAppearance.NovelVerse.TabText"
             app:tabIndicatorFullWidth="false"
             app:tabIndicatorHeight="3dp"
             android:id="@+id/follows_tab_layout"
             app:tabRippleColor="@color/transparent" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
         android:layout_height="0dp"
         android:layout_width="match_parent"
         android:layout_weight="1"
         android:id="@+id/follows_view_pager" />

</LinearLayout>