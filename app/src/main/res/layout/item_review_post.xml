<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:orientation="vertical"
     android:paddingHorizontal="16dp"
     android:paddingTop="16dp">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:orientation="horizontal">

        <ImageView
             android:layout_height="44dp"
             android:layout_width="44dp"
             android:scaleType="centerCrop"
             android:contentDescription="Reviewer avatar"
             android:background="@drawable/profile_default"
             android:id="@+id/post_avatar" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:orientation="vertical"
             android:layout_marginStart="11dp"
             android:layout_weight="1">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:ellipsize="end"
                     android:textSize="17sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:maxLines="1"
                     android:id="@+id/post_display_name" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:background="@drawable/bg_rank_bookworm"
                     android:paddingVertical="3dp"
                     android:textSize="11sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="#2E7D32"
                     android:layout_marginStart="6dp"
                     android:paddingHorizontal="8dp"
                     android:id="@+id/post_rank_badge" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="2dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="12sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="@color/text_secondary"
                     android:id="@+id/post_username" />

                <View
                     android:layout_height="3dp"
                     android:layout_width="3dp"
                     android:background="@color/text_tertiary"
                     android:layout_marginHorizontal="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="12sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="@color/text_secondary"
                     android:id="@+id/post_time_ago" />

                <View
                     android:layout_height="3dp"
                     android:layout_width="3dp"
                     android:background="@color/text_tertiary"
                     android:layout_marginHorizontal="5dp" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:textSize="11sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="@color/text_secondary"
                     android:id="@+id/post_genre_pill" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:visibility="gone"
         android:ellipsize="end"
         android:textSize="16sp"
         android:fontFamily="@font/inter_medium"
         android:textColor="?attr/colorOnSurface"
         android:layout_marginTop="10dp"
         android:lineSpacingMultiplier="1.55"
         android:maxLines="5"
         android:id="@+id/post_review_text" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@drawable/bg_surface_card"
         android:clickable="true"
         android:padding="11dp"
         android:orientation="horizontal"
         android:layout_marginTop="11dp"
         android:focusable="true"
         android:id="@+id/post_novel_card">

        <ImageView
             android:layout_height="72dp"
             android:layout_width="52dp"
             android:src="@drawable/ic_book_open"
             android:scaleType="centerCrop"
             android:contentDescription="Novel cover"
             android:background="@drawable/bg_card_gradient_default"
             android:id="@+id/post_novel_cover" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:gravity="center_vertical"
             android:orientation="vertical"
             android:layout_marginStart="12dp"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:ellipsize="end"
                 android:textSize="15sp"
                 android:fontFamily="@font/nunito_semibold"
                 android:textColor="?attr/colorOnSurface"
                 android:maxLines="2"
                 android:id="@+id/post_novel_title" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:ellipsize="end"
                 android:textSize="12sp"
                 android:fontFamily="@font/inter_regular"
                 android:textColor="@color/text_secondary"
                 android:layout_marginTop="3dp"
                 android:maxLines="1"
                 android:id="@+id/post_novel_author" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="8dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:background="@drawable/bg_chip_inactive"
                     android:paddingVertical="3dp"
                     android:textSize="11sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="@color/text_secondary"
                     android:paddingHorizontal="9dp"
                     android:id="@+id/post_novel_recommendations" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:background="@drawable/bg_chip_inactive"
                     android:paddingVertical="3dp"
                     android:textSize="11sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="@color/text_secondary"
                     android:layout_marginStart="6dp"
                     android:paddingHorizontal="9dp"
                     android:id="@+id/post_novel_year" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
             android:layout_height="22dp"
             android:layout_width="22dp"
             android:src="@drawable/ic_bookmark"
             android:scaleType="fitCenter"
             android:contentDescription="Bookmark"
             android:tint="@color/text_tertiary"
             android:layout_marginStart="8dp"
             android:id="@+id/post_bookmark_icon"
             android:layout_gravity="top" />

    </LinearLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:layout_marginTop="10dp"
         android:id="@+id/post_star_row">

    </LinearLayout>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:paddingBottom="4dp"
         android:layout_marginTop="10dp">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="13sp"
             android:fontFamily="@font/inter_regular"
             android:textColor="@color/text_secondary"
             android:id="@+id/post_likes_count"
             android:text="0 likes" />

        <View
             android:layout_height="3dp"
             android:layout_width="3dp"
             android:background="@color/text_tertiary"
             android:layout_marginHorizontal="8dp" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:textSize="13sp"
             android:fontFamily="@font/inter_regular"
             android:textColor="@color/text_secondary"
             android:layout_weight="1"
             android:id="@+id/post_responses_count"
             android:text="0 responses" />

        <ImageView
             android:layout_height="24dp"
             android:layout_width="24dp"
             android:src="@drawable/ic_like_outline"
             android:scaleType="fitCenter"
             android:contentDescription="Like"
             android:clickable="true"
             android:focusable="true"
             android:id="@+id/post_heart_btn" />

    </LinearLayout>

    <View
         android:layout_height="1dp"
         android:layout_width="match_parent"
         android:background="@color/divider"
         android:layout_marginTop="12dp" />

</LinearLayout>