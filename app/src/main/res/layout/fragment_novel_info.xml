<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="?attr/colorSurface">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:padding="16dp"
         android:orientation="vertical"
         android:paddingBottom="40dp">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_marginBottom="8dp"
             android:textSize="12sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="@color/text_tertiary"
             android:letterSpacing="0.10"
             android:text="COVER IMAGE" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_marginBottom="16dp"
             android:gravity="center_vertical"
             android:background="@drawable/bg_surface_card"
             android:elevation="1dp"
             android:padding="14dp"
             android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                 xmlns:app="http://schemas.android.com/apk/res-auto"
                 android:layout_height="96dp"
                 android:layout_width="70dp"
                 android:layout_marginEnd="14dp"
                 app:cardElevation="3dp"
                 app:cardCornerRadius="8dp">

                <ImageView
                     android:layout_height="match_parent"
                     android:layout_width="match_parent"
                     android:scaleType="centerCrop"
                     android:src="@drawable/img_placeholder_cover"
                     android:contentDescription="Cover"
                     android:id="@+id/info_cover" />

            </androidx.cardview.widget.CardView>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:background="@drawable/bg_btn_outlined_error"
                 android:paddingVertical="8dp"
                 android:textSize="14sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="@color/primary"
                 android:paddingHorizontal="16dp"
                 android:id="@+id/btn_change_cover"
                 android:text="Change Cover" />

        </LinearLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_marginBottom="8dp"
             android:textSize="12sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="@color/text_tertiary"
             android:letterSpacing="0.10"
             android:text="DETAILS" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_marginBottom="16dp"
             android:background="@drawable/bg_surface_card"
             android:elevation="1dp"
             android:padding="16dp"
             android:orientation="vertical">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginBottom="4dp"
                 android:textSize="13sp"
                 android:fontFamily="@font/inter_medium"
                 android:textColor="@color/text_secondary"
                 android:text="Title" />

            <EditText
                 android:layout_height="50dp"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="14dp"
                 android:background="@drawable/bg_search_bar"
                 android:textSize="15sp"
                 android:fontFamily="@font/inter_regular"
                 android:singleLine="true"
                 android:paddingHorizontal="14dp"
                 android:id="@+id/info_title" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginBottom="4dp"
                 android:textSize="13sp"
                 android:fontFamily="@font/inter_medium"
                 android:textColor="@color/text_secondary"
                 android:text="Description" />

            <EditText
                 android:layout_height="110dp"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="14dp"
                 android:background="@drawable/bg_search_bar"
                 android:gravity="top"
                 android:paddingVertical="12dp"
                 android:textSize="15sp"
                 android:fontFamily="@font/inter_regular"
                 android:paddingHorizontal="14dp"
                 android:maxLines="5"
                 android:id="@+id/info_description" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginBottom="6dp"
                 android:textSize="13sp"
                 android:fontFamily="@font/inter_medium"
                 android:textColor="@color/text_secondary"
                 android:text="Status" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal">

                <TextView
                     android:layout_height="38dp"
                     android:layout_width="0dp"
                     android:layout_marginEnd="6dp"
                     android:gravity="center"
                     android:background="@drawable/bg_chip_inactive"
                     android:textSize="13sp"
                     android:fontFamily="@font/inter_semibold"
                     android:layout_weight="1"
                     android:id="@+id/status_ongoing"
                     android:text="Ongoing" />

                <TextView
                     android:layout_height="38dp"
                     android:layout_width="0dp"
                     android:layout_marginEnd="6dp"
                     android:gravity="center"
                     android:background="@drawable/bg_chip_inactive"
                     android:textSize="13sp"
                     android:fontFamily="@font/inter_semibold"
                     android:layout_weight="1"
                     android:id="@+id/status_hiatus"
                     android:text="Hiatus" />

                <TextView
                     android:layout_height="38dp"
                     android:layout_width="0dp"
                     android:gravity="center"
                     android:background="@drawable/bg_chip_inactive"
                     android:textSize="13sp"
                     android:fontFamily="@font/inter_semibold"
                     android:layout_weight="1"
                     android:id="@+id/status_completed"
                     android:text="Completed" />

            </LinearLayout>

        </LinearLayout>

        <TextView
             android:layout_height="52dp"
             android:layout_width="match_parent"
             android:gravity="center"
             android:background="@drawable/bg_btn_primary"
             android:textSize="16sp"
             android:fontFamily="@font/inter_semibold"
             android:textColor="?attr/colorSurface"
             android:id="@+id/btn_save_info"
             android:text="Save Changes" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>