<?xml version="1.0" encoding="utf-8"?>
<ScrollView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:fillViewport="true">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:paddingHorizontal="24dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:orientation="horizontal"
             android:layout_marginTop="16dp">

            <ImageButton
                 android:layout_height="16dp"
                 android:layout_width="16dp"
                 android:contentDescription="@string/back"
                 android:src="@drawable/ic_arrow_left"
                 android:background="?attr/selectableItemBackgroundBorderless"
                 app:tint="@color/icon_primary"
                 android:id="@+id/btn_back" />

            <View
                 android:layout_height="0dp"
                 android:layout_width="0dp"
                 android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:id="@+id/state_request">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:fontFamily="@font/inter_bold"
                 android:textSize="28sp"
                 android:textColor="@color/text_primary"
                 android:layout_marginTop="32dp"
                 android:letterSpacing="0.05"
                 android:text="@string/reset_password" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:fontFamily="@font/inter_regular"
                 android:textSize="16sp"
                 android:textColor="@color/text_secondary"
                 android:layout_marginTop="8dp"
                 android:text="Enter your account email and we\'ll send you a link to reset your password." />

            <com.google.android.material.textfield.TextInputLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 app:hintEnabled="false"
                 app:boxStrokeColor="@color/auth_input_stroke"
                 app:boxCornerRadiusBottomEnd="14dp"
                 android:layout_marginTop="32dp"
                 app:boxCornerRadiusTopStart="14dp"
                 app:boxStrokeWidth="1dp"
                 app:boxCornerRadiusTopEnd="14dp"
                 app:boxCornerRadiusBottomStart="14dp"
                 app:boxStrokeWidthFocused="2dp"
                 app:cursorColor="@color/button_blue"
                 app:boxBackgroundColor="@color/background_opp"
                 app:startIconTint="@color/auth_input_icon"
                 style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                 app:startIconDrawable="@drawable/ic_at_sign"
                 android:id="@+id/email_layout">

                <com.google.android.material.textfield.TextInputEditText
                     android:layout_height="50dp"
                     android:layout_width="match_parent"
                     android:hint="@string/email_address"
                     android:paddingVertical="-2dp"
                     android:textColorHint="@color/icon_secondary"
                     android:fontFamily="@font/inter_regular"
                     android:textSize="16sp"
                     android:textColor="@color/text_primary"
                     android:inputType="textEmailAddress"
                     android:id="@+id/email_input" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                 android:layout_height="49dp"
                 android:layout_width="match_parent"
                 app:backgroundTint="@color/button_blue"
                 android:paddingVertical="-2dp"
                 android:fontFamily="@font/inter_semibold"
                 android:textSize="16sp"
                 app:cornerRadius="16dp"
                 android:textColor="@color/white"
                 android:layout_marginTop="32dp"
                 android:id="@+id/btn_send_reset"
                 android:text="@string/send_reset_link" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:clickable="true"
                 android:padding="8dp"
                 android:textSize="16sp"
                 android:textColor="@color/button_blue"
                 android:layout_marginTop="24dp"
                 android:focusable="true"
                 android:layout_gravity="center_horizontal"
                 android:background="?attr/selectableItemBackground"
                 android:fontFamily="@font/inter_semibold"
                 android:id="@+id/btn_back_to_login"
                 android:text="Back to Sign In" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:visibility="gone"
             android:orientation="vertical"
             android:id="@+id/state_sent">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:fontFamily="@font/inter_bold"
                 android:textSize="28sp"
                 android:textColor="@color/text_primary"
                 android:layout_marginTop="32dp"
                 android:letterSpacing="0.05"
                 android:text="Check your inbox" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:fontFamily="@font/inter_regular"
                 android:textSize="16sp"
                 android:textColor="@color/text_secondary"
                 android:layout_marginTop="8dp"
                 android:id="@+id/sent_subtitle" />

            <ImageView
                 android:layout_height="72dp"
                 android:layout_width="72dp"
                 android:src="@drawable/ic_mail"
                 android:alpha="0.7"
                 app:tint="@color/button_blue"
                 android:layout_marginTop="40dp"
                 android:layout_gravity="center_horizontal" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center"
                 android:fontFamily="@font/inter_regular"
                 android:textSize="15sp"
                 android:textColor="@color/text_secondary"
                 android:layout_marginTop="24dp"
                 android:text="Tap the link in the email to open NovelVerse and set a new password. It may take a minute or two to arrive." />

            <com.google.android.material.button.MaterialButton
                 android:layout_height="49dp"
                 android:layout_width="match_parent"
                 app:backgroundTint="@color/button_blue"
                 android:paddingVertical="-2dp"
                 android:fontFamily="@font/inter_semibold"
                 android:textSize="16sp"
                 app:cornerRadius="16dp"
                 android:textColor="@color/white"
                 android:layout_marginTop="32dp"
                 android:id="@+id/btn_open_email"
                 android:text="Open Email App" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:clickable="true"
                 android:padding="8dp"
                 android:textSize="14sp"
                 android:textColor="@color/text_secondary"
                 android:layout_marginTop="16dp"
                 android:focusable="true"
                 android:layout_gravity="center_horizontal"
                 android:background="?attr/selectableItemBackground"
                 android:fontFamily="@font/inter_regular"
                 android:id="@+id/btn_resend"
                 android:text="Didn\'t get it? Resend" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:clickable="true"
                 android:padding="8dp"
                 android:textSize="16sp"
                 android:textColor="@color/button_blue"
                 android:layout_marginTop="8dp"
                 android:focusable="true"
                 android:layout_gravity="center_horizontal"
                 android:background="?attr/selectableItemBackground"
                 android:fontFamily="@font/inter_semibold"
                 android:id="@+id/btn_sent_back_to_login"
                 android:text="Back to Sign In" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>