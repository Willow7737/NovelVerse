<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/banner_bg">

    <com.google.android.material.appbar.AppBarLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="?attr/colorSurface"
         app:elevation="0dp"
         android:fitsSystemWindows="true"
         android:id="@+id/app_bar">

        <androidx.appcompat.widget.Toolbar
             android:layout_height="?attr/actionBarSize"
             android:layout_width="match_parent"
             android:background="@color/banner_bg"
             app:navigationIconTint="?attr/colorOnSurface"
             app:title="My Streak"
             app:titleTextAppearance="@style/TextAppearance.NovelVerse.TitleMedium"
             app:navigationIcon="@drawable/ic_back"
             app:titleTextColor="@color/border"
             android:id="@+id/toolbar_streak" />

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:background="@color/divider" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         app:layout_behavior="@string/appbar_scrolling_view_behavior"
         android:id="@+id/streak_scroll"
         android:overScrollMode="never">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingEnd="16dp"
             android:orientation="vertical"
             android:paddingBottom="96dp"
             android:paddingStart="16dp"
             android:paddingTop="16dp">


                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:paddingEnd="20dp"
                     android:gravity="center"
                     android:orientation="vertical"
                     android:paddingBottom="24dp"
                     android:paddingStart="20dp"
                     android:paddingTop="28dp">

                    <ImageView
                         android:layout_height="94dp"
                         android:layout_width="94dp"
                         android:src="@drawable/ic_streak_flame"
                         android:scaleType="fitCenter"
                         android:contentDescription="Streak flame"
                         android:id="@+id/iv_streak_flame" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:includeFontPadding="false"
                         android:textSize="56sp"
                         android:fontFamily="@font/inter_bold"
                         android:textColor="@color/secondary"
                         android:layout_marginTop="0dp"
                         android:id="@+id/tv_streak_number"
                         android:text="0" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="2dp"
                         android:letterSpacing="0.12"
                         android:text="DAY STREAK" />

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:visibility="gone"
                         android:gravity="center"
                         android:orientation="horizontal"
                         android:layout_marginTop="14dp"
                         android:id="@+id/streak_status_row">

                    </LinearLayout>

                </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="12dp"
                 app:cardElevation="1dp"
                 app:cardBackgroundColor="?attr/colorSurface"
                 app:cardCornerRadius="16dp">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:padding="16dp"
                     android:orientation="vertical">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:layout_marginBottom="12dp"
                         android:textSize="13sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:text="Last 7 Days" />

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:gravity="center"
                         android:orientation="horizontal"
                         android:id="@+id/week_row">

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="12dp"
                 android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:layout_marginEnd="6dp"
                     app:cardElevation="1dp"
                     app:cardBackgroundColor="?attr/colorSurface"
                     app:cardCornerRadius="14dp"
                     android:layout_weight="1">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:gravity="center"
                         android:padding="12dp"
                         android:orientation="vertical">

                        <ImageView
                             android:layout_height="22dp"
                             android:layout_width="22dp"
                             android:src="@drawable/ic_streak_flame"
                             android:scaleType="fitCenter"
                             android:contentDescription="Longest streak" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="20sp"
                             android:fontFamily="@font/inter_bold"
                             android:textColor="?attr/colorOnSurface"
                             android:layout_marginTop="6dp"
                             android:id="@+id/tv_longest_value"
                             android:text="0" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="10sp"
                             android:fontFamily="@font/inter_medium"
                             android:textColor="?attr/colorOnSurfaceVariant"
                             android:text="Longest" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:layout_marginEnd="3dp"
                     app:cardElevation="1dp"
                     app:cardBackgroundColor="?attr/colorSurface"
                     android:layout_marginStart="3dp"
                     app:cardCornerRadius="14dp"
                     android:layout_weight="1">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:gravity="center"
                         android:padding="12dp"
                         android:orientation="vertical">

                        <ImageView
                             android:layout_height="22dp"
                             android:layout_width="22dp"
                             android:src="@drawable/ic_streak_flame_dark"
                             android:scaleType="fitCenter"
                             android:contentDescription="Freeze"
                             android:id="@+id/iv_freeze_icon" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="13sp"
                             android:fontFamily="@font/inter_bold"
                             android:textColor="?attr/colorOnSurface"
                             android:layout_marginTop="6dp"
                             android:id="@+id/tv_freeze_value"
                             android:text="None" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="10sp"
                             android:fontFamily="@font/inter_medium"
                             android:textColor="?attr/colorOnSurfaceVariant"
                             android:text="Freeze" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     app:cardElevation="1dp"
                     app:cardBackgroundColor="?attr/colorSurface"
                     android:layout_marginStart="6dp"
                     app:cardCornerRadius="14dp"
                     android:layout_weight="1">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:gravity="center"
                         android:padding="12dp"
                         android:orientation="vertical">

                        <ImageView
                             android:layout_height="22dp"
                             android:layout_width="22dp"
                             android:src="@drawable/ic_badge_streak_7"
                             android:scaleType="fitCenter"
                             android:contentDescription="Grace period" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="13sp"
                             android:fontFamily="@font/inter_bold"
                             android:textColor="?attr/colorOnSurface"
                             android:layout_marginTop="6dp"
                             android:id="@+id/tv_grace_value"
                             android:text="Ready" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="10sp"
                             android:fontFamily="@font/inter_medium"
                             android:textColor="?attr/colorOnSurfaceVariant"
                             android:text="Grace" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="12dp"
                 app:cardElevation="1dp"
                 app:cardBackgroundColor="?attr/colorSurface"
                 app:cardCornerRadius="16dp"
                 android:id="@+id/card_ad_rewards">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:padding="16dp"
                     android:orientation="vertical">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:layout_marginBottom="4dp"
                         android:textSize="15sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:text="Earn Rewards" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:layout_marginBottom="14dp"
                         android:textSize="12sp"
                         android:fontFamily="@font/inter_regular"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:text="Watch short ads to earn Ink, protect your streak, or recover a lost one." />

                    <LinearLayout
                         android:layout_height="48dp"
                         android:layout_width="match_parent"
                         android:layout_marginBottom="8dp"
                         android:paddingEnd="14dp"
                         android:gravity="center_vertical"
                         android:background="@drawable/bg_home_section_card"
                         android:clickable="true"
                         android:orientation="horizontal"
                         android:paddingStart="14dp"
                         android:focusable="true"
                         android:id="@+id/btn_ad_ink"
                         android:foreground="?attr/selectableItemBackground">

                        <ImageView
                             android:layout_height="20dp"
                             android:layout_width="20dp"
                             android:src="@drawable/ic_streak_flame"
                             android:scaleType="fitCenter"
                             android:contentDescription="Ink reward" />

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:orientation="vertical"
                             android:layout_marginStart="10dp"
                             android:layout_weight="1">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="13sp"
                                 android:fontFamily="@font/inter_semibold"
                                 android:textColor="?attr/colorOnSurface"
                                 android:text="Watch Ad → +25 Ink" />

                        </LinearLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="11sp"
                             android:fontFamily="@font/inter_regular"
                             android:textColor="?attr/colorOnSurfaceVariant"
                             android:id="@+id/tv_ink_ad_count"
                             android:text="0/3 today" />

                    </LinearLayout>

                    <LinearLayout
                         android:layout_height="48dp"
                         android:layout_width="match_parent"
                         android:layout_marginBottom="8dp"
                         android:paddingEnd="14dp"
                         android:gravity="center_vertical"
                         android:background="@drawable/bg_home_section_card"
                         android:clickable="true"
                         android:orientation="horizontal"
                         android:paddingStart="14dp"
                         android:focusable="true"
                         android:id="@+id/btn_ad_freeze"
                         android:foreground="?attr/selectableItemBackground">

                        <ImageView
                             android:layout_height="20dp"
                             android:layout_width="20dp"
                             android:src="@drawable/ic_streak_flame_dark"
                             android:scaleType="fitCenter"
                             android:contentDescription="Streak freeze" />

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:orientation="vertical"
                             android:layout_marginStart="10dp"
                             android:layout_weight="1">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="13sp"
                                 android:fontFamily="@font/inter_semibold"
                                 android:textColor="?attr/colorOnSurface"
                                 android:text="Watch Ad → Get Streak Freeze" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="11sp"
                                 android:fontFamily="@font/inter_regular"
                                 android:textColor="?attr/colorOnSurfaceVariant"
                                 android:text="Protects your streak for 48h" />

                        </LinearLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="11sp"
                             android:fontFamily="@font/inter_regular"
                             android:textColor="?attr/colorOnSurfaceVariant"
                             android:id="@+id/tv_freeze_ad_count"
                             android:text="1/day" />

                    </LinearLayout>

                    <LinearLayout
                         android:layout_height="48dp"
                         android:layout_width="match_parent"
                         android:visibility="gone"
                         android:paddingEnd="14dp"
                         android:gravity="center_vertical"
                         android:background="@drawable/bg_home_section_card"
                         android:clickable="true"
                         android:orientation="horizontal"
                         android:paddingStart="14dp"
                         android:focusable="true"
                         android:id="@+id/btn_ad_recover"
                         android:foreground="?attr/selectableItemBackground">

                        <ImageView
                             android:layout_height="20dp"
                             android:layout_width="20dp"
                             android:src="@drawable/ic_badge_streak_7"
                             android:scaleType="fitCenter"
                             android:contentDescription="Recover streak" />

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:orientation="vertical"
                             android:layout_marginStart="10dp"
                             android:layout_weight="1">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="13sp"
                                 android:fontFamily="@font/inter_semibold"
                                 android:textColor="@color/accent_coral"
                                 android:id="@+id/tv_recover_label"
                                 android:text="Watch Ad → Recover Lost Streak" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="11sp"
                                 android:fontFamily="@font/inter_regular"
                                 android:textColor="?attr/colorOnSurfaceVariant"
                                 android:text="Undo a streak break from the last 48h" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:layout_marginBottom="8dp"
                 android:textSize="15sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="?attr/colorOnBackground"
                 android:layout_marginTop="4dp"
                 android:text="Past Streaks" />

            <androidx.recyclerview.widget.RecyclerView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:nestedScrollingEnabled="false"
                 android:id="@+id/rv_past_streaks"
                 android:overScrollMode="never" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:gravity="center"
                 android:padding="24dp"
                 android:orientation="vertical"
                 android:id="@+id/past_streaks_empty">

                <ImageView
                     android:layout_height="40dp"
                     android:layout_width="40dp"
                     android:src="@drawable/ic_streak_flame"
                     android:scaleType="fitCenter"
                     android:contentDescription="No past streaks"
                     android:alpha="0.35" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:gravity="center"
                     android:textSize="13sp"
                     android:fontFamily="@font/inter_regular"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:layout_marginTop="10dp"
                     android:text="No past streaks yet" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>