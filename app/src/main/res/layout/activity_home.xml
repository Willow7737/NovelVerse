<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@drawable/bg_app_main">

    <com.google.android.material.appbar.AppBarLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@android:color/transparent"
         app:liftOnScroll="false"
         app:elevation="0dp"
         android:stateListAnimator="@null"
         android:fitsSystemWindows="true"
         android:id="@+id/app_bar">

        <androidx.appcompat.widget.Toolbar
             android:layout_height="62dp"
             android:layout_width="match_parent"
             android:background="@android:color/transparent"
             app:contentInsetStart="0dp"
             app:contentInsetEnd="0dp"
             android:id="@+id/toolbar">

            <!--
                3-zone header using RelativeLayout:
                  LEFT   — fire icon + streak count
                  CENTER — logo_text png
                  RIGHT  — outlined pill with search | divider | notifications
            -->
            <RelativeLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:paddingStart="16dp"
                 android:paddingEnd="14dp">

                <!-- ── LEFT: Streak widget ─────────────────────────── -->
                <LinearLayout
                     android:id="@+id/streak_widget"
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_alignParentStart="true"
                     android:layout_centerVertical="true"
                     android:gravity="center_vertical"
                     android:orientation="horizontal">

                    <ImageView
                         android:id="@+id/ic_streak_flame_icon"
                         android:layout_height="24dp"
                         android:layout_width="24dp"
                         android:src="@drawable/ic_streak_flame"
                         android:scaleType="fitCenter"
                         android:contentDescription="Streak fire" />

                    <TextView
                         android:id="@+id/tv_streak_count"
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:layout_marginStart="5dp"
                         android:textSize="16sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="@color/secondary"
                         android:text="0" />

                </LinearLayout>

                <!-- ── CENTER: Logo text ───────────────────────────── -->
                <ImageView
                     android:layout_height="26dp"
                     android:layout_width="wrap_content"
                     android:layout_centerInParent="true"
                     android:src="@drawable/logo_text"
                     android:scaleType="fitCenter"
                     android:adjustViewBounds="true"
                     android:contentDescription="NovelVerse" />

                <!-- ── RIGHT: Pill — search | divider | notifications ─ -->
                <LinearLayout
                     android:layout_height="38dp"
                     android:layout_width="wrap_content"
                     android:layout_alignParentEnd="true"
                     android:layout_centerVertical="true"
                     android:background="@drawable/bg_header_pill"
                     android:gravity="center_vertical"
                     android:orientation="horizontal">

                    <ImageButton
                         android:id="@+id/btn_search_header"
                         android:layout_height="38dp"
                         android:layout_width="42dp"
                         android:background="@android:color/transparent"
                         android:padding="9dp"
                         android:src="@drawable/ic_search_outline"
                         android:tint="?attr/colorOnSurfaceVariant"
                         android:contentDescription="Search" />

                    <!-- Broken vertical divider (inset from top/bottom gives the gap effect) -->
                    <View
                         android:layout_height="16dp"
                         android:layout_width="1dp"
                         android:background="#3C3C3E" />

                    <ImageButton
                         android:id="@+id/btn_notification"
                         android:layout_height="38dp"
                         android:layout_width="42dp"
                         android:background="@android:color/transparent"
                         android:padding="9dp"
                         android:src="@drawable/ic_bell_outline"
                         android:tint="?attr/colorOnSurfaceVariant"
                         android:contentDescription="Notifications" />

                </LinearLayout>

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:background="@color/divider"
             android:alpha="0.35" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent"
         android:background="@android:color/transparent"
         android:paddingBottom="10dp"
         android:id="@+id/fragment_container">

    </FrameLayout>

    <com.novelverse.app.presentation.common.views.FloatingNavBar
         android:layout_height="50dp"
         android:layout_width="wrap_content"
         android:layout_marginBottom="14dp"
         android:layout_gravity="bottom|center_horizontal"
         android:id="@+id/bottom_navigation" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
