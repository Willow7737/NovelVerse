<?xml version="1.0" encoding="utf-8"?>
<!--
  Achievements Tab Fragment
  Clean layout:
    • Horizontal filter chip scroll (All / Reader / Writer / Streak / Social / Supporter)
    • Full-height RecyclerView for the achievement cards
    • Empty state with icon + text
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- ── Filter chip scroll bar ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <!-- All -->
            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip_active"
                android:textSize="13sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/chip_selected_text"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="All" />

            <!-- Reader -->
            <TextView
                android:id="@+id/chip_reader"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip_inactive"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/chip_unselected_text"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Reader" />

            <!-- Writer -->
            <TextView
                android:id="@+id/chip_writer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip_inactive"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/chip_unselected_text"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Writer" />

            <!-- Streak -->
            <TextView
                android:id="@+id/chip_streak"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip_inactive"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/chip_unselected_text"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Streak" />

            <!-- Social -->
            <TextView
                android:id="@+id/chip_social"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip_inactive"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/chip_unselected_text"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Social" />

            <!-- Supporter -->
            <TextView
                android:id="@+id/chip_supporter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_chip_inactive"
                android:textSize="13sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/chip_unselected_text"
                android:clickable="true"
                android:focusable="true"
                android:text="Supporter" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Hairline under chips -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <!-- Achievement RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/achievements_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="32dp" />

</LinearLayout>
