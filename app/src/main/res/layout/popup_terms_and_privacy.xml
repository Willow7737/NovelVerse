<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_text_selection_popup_body"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Message -->
    <TextView
        android:id="@+id/tv_popup_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="By tapping Agree, you acknowledge that you have read and accept our"
        android:textSize="14sp"
        android:fontFamily="@font/inter_medium"
        android:textColor="#B3FFFFFF"
        android:textAlignment="center"
        android:layout_gravity="center_horizontal"
        android:lineSpacingExtra="4dp" />

    <!-- Clickable links row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_gravity="center_horizontal">

        <TextView
            android:id="@+id/btn_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms &amp; Conditions"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_medium"
            android:textColor="#FFE94560"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" &amp; "
            android:textSize="14sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="#B3FFFFFF" />

        <TextView
            android:id="@+id/btn_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Policy"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_medium"
            android:textColor="#FFE94560"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="4dp" />
    </LinearLayout>

    <!-- Agree / Disagree -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Disagree — secondary / ghost button -->
        <TextView
            android:id="@+id/btn_action_disagree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Disagree"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_medium"
            android:textColor="#8AFFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:letterSpacing="0.02" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#4DFFFFFF"
            android:layout_marginVertical="10dp" />

        <!-- Agree — primary / filled button -->
        <TextView
            android:id="@+id/btn_action_agree"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Agree"
            android:textSize="15sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/button_blue"
            android:gravity="center"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:letterSpacing="0.02" />
    </LinearLayout>
</LinearLayout>