<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:background="?attr/colorSurface"
     android:padding="20dp"
     android:orientation="vertical">

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_marginBottom="16dp"
         android:textSize="20sp"
         android:fontFamily="@font/inter_semibold"
         android:textColor="?attr/colorOnSurface"
         android:text="Filter Novels" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_marginBottom="8dp"
         android:textSize="14sp"
         android:fontFamily="@font/inter_semibold"
         android:textColor="?attr/colorOnSurfaceVariant"
         android:text="Status" />

    <com.google.android.material.chip.ChipGroup
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         app:singleSelection="true"
         app:selectionRequired="true"
         android:id="@+id/chip_group_status">

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:checked="true"
             android:text="All" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="Ongoing" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="Completed" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="Hiatus" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_marginBottom="8dp"
         android:textSize="14sp"
         android:fontFamily="@font/inter_semibold"
         android:textColor="?attr/colorOnSurfaceVariant"
         android:text="Rating" />

    <com.google.android.material.chip.ChipGroup
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         app:singleSelection="true"
         app:selectionRequired="true"
         android:id="@+id/chip_group_rating">

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:checked="true"
             android:text="Any" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="4★+" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="3★+" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_marginBottom="8dp"
         android:textSize="14sp"
         android:fontFamily="@font/inter_semibold"
         android:textColor="?attr/colorOnSurfaceVariant"
         android:text="Chapter Count" />

    <com.google.android.material.chip.ChipGroup
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         app:singleSelection="true"
         app:selectionRequired="true"
         android:id="@+id/chip_group_chapters">

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:checked="true"
             android:text="Any" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="1–20" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="20–100" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="100+" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="wrap_content"
         android:layout_marginBottom="8dp"
         android:textSize="14sp"
         android:fontFamily="@font/inter_semibold"
         android:textColor="?attr/colorOnSurfaceVariant"
         android:text="Content Rating" />

    <com.google.android.material.chip.ChipGroup
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="24dp"
         app:singleSelection="true"
         app:selectionRequired="true"
         android:id="@+id/chip_group_content">

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:checked="true"
             android:text="All" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="General" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="Teen" />

        <com.google.android.material.chip.Chip
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="Mature" />

    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="end"
         android:orientation="horizontal">

        <TextView
             android:layout_height="48dp"
             android:layout_width="wrap_content"
             android:gravity="center"
             android:textSize="15sp"
             android:fontFamily="@font/inter_medium"
             android:textColor="@color/primary"
             android:paddingHorizontal="16dp"
             android:id="@+id/btn_reset_filters"
             android:text="Reset" />

        <com.google.android.material.button.MaterialButton
             android:layout_height="48dp"
             android:layout_width="wrap_content"
             android:textSize="15sp"
             android:layout_marginStart="8dp"
             android:id="@+id/btn_apply_filters"
             android:text="Apply Filters" />

    </LinearLayout>

</LinearLayout>