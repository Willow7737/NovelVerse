<?xml version="1.0" encoding="utf-8"?>
<ScrollView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:fillViewport="true">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:paddingHorizontal="24dp">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:orientation="horizontal"
             android:layout_marginTop="16dp">

            <ImageButton
                 android:layout_height="28dp"
                 android:layout_width="28dp"
                 android:src="@drawable/ic_arrow_left"
                 android:contentDescription="@string/back"
                 android:background="?attr/selectableItemBackgroundBorderless"
                 android:tint="@color/icon_primary"
                 android:id="@+id/btn_back" />

            <View
                 android:layout_height="0dp"
                 android:layout_width="0dp"
                 android:layout_weight="1" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:background="?attr/selectableItemBackground"
                 android:clickable="true"
                 android:padding="8dp"
                 android:textSize="14sp"
                 android:fontFamily="@font/inter_semibold"
                 android:textColor="@color/text_primary"
                 android:focusable="true"
                 android:id="@+id/btn_header_sign_up"
                 android:text="@string/sign_up" />

        </LinearLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:textSize="28sp"
             android:fontFamily="@font/inter_bold"
             android:textColor="@color/text_primary"
             android:layout_marginTop="32dp"
             android:letterSpacing="0.05"
             android:text="@string/welcome_back" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:textSize="16sp"
             android:fontFamily="@font/inter_regular"
             android:textColor="@color/text_secondary"
             android:layout_marginTop="8dp"
             android:text="@string/sign_in_to_continue" />

        <com.google.android.material.textfield.TextInputLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:hint="@string/email_address"
             app:startIconTint="@color/icon_secondary"
             style="@style/Widget.Material3.TextInputLayout.FilledBox"
             android:layout_marginTop="32dp"
             app:hintTextColor="@color/text_secondary"
             app:startIconDrawable="@drawable/ic_mail"
             android:id="@+id/email_layout">

            <com.google.android.material.textfield.TextInputEditText
                 android:layout_height="56dp"
                 android:layout_width="match_parent"
                 android:background="@drawable/bg_onboarding_chip_unselected"
                 android:textSize="16sp"
                 android:inputType="textEmailAddress"
                 android:id="@+id/email_input" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             app:endIconMode="password_toggle"
             android:hint="@string/password"
             app:endIconTintMode="@color/icon_secondary"
             app:startIconTint="@color/icon_secondary"
             app:hintTextColor="@color/text_secondary"
             style="@style/Widget.Material3.TextInputLayout.FilledBox"
             android:layout_marginTop="16dp"
             app:startIconDrawable="@drawable/ic_lock"
             android:id="@+id/password_layout">

            <com.google.android.material.textfield.TextInputEditText
                 android:layout_height="56dp"
                 android:layout_width="match_parent"
                 android:background="@drawable/bg_onboarding_chip_unselected"
                 android:textSize="16sp"
                 android:inputType="textPassword"
                 android:id="@+id/password_input" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:clickable="true"
             android:padding="4dp"
             android:textSize="14sp"
             android:textColor="@color/text_secondary"
             android:layout_marginTop="12dp"
             android:focusable="true"
             android:layout_gravity="end"
             android:background="?attr/selectableItemBackground"
             android:fontFamily="@font/inter_medium"
             android:id="@+id/forgot_password_link"
             android:text="@string/forgot_password" />

        <com.google.android.material.button.MaterialButton
             android:layout_height="56dp"
             android:layout_width="match_parent"
             app:backgroundTint="@color/button_blue"
             android:textSize="16sp"
             android:fontFamily="@font/inter_semibold"
             app:cornerRadius="16dp"
             android:textColor="@color/white"
             android:layout_marginTop="32dp"
             android:id="@+id/btn_sign_in"
             android:text="@string/sign_in" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="14sp"
             android:fontFamily="@font/inter_regular"
             android:textColor="@color/text_tertiary"
             android:layout_marginTop="24dp"
             android:layout_gravity="center_horizontal"
             android:text="@string/or_continue_with" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_marginBottom="24dp"
             android:orientation="horizontal"
             android:layout_marginTop="16dp"
             android:layout_gravity="center_horizontal">

            <ImageButton
                 android:layout_height="48dp"
                 android:layout_width="48dp"
                 android:src="@drawable/ic_google"
                 android:scaleType="centerInside"
                 android:contentDescription="@string/google_sign_in"
                 android:background="@drawable/bg_social_button"
                 android:padding="0dp"
                 android:id="@+id/btn_social_google" />

            <View
                 android:layout_height="0dp"
                 android:layout_width="16dp" />

            <ImageButton
                 android:layout_height="48dp"
                 android:layout_width="48dp"
                 android:src="@drawable/ic_apple"
                 android:scaleType="centerInside"
                 android:tint="@color/text_primary"
                 android:contentDescription="@string/apple_sign_in"
                 android:background="@drawable/bg_social_button"
                 android:padding="0dp"
                 android:id="@+id/btn_social_apple" />

            <View
                 android:layout_height="0dp"
                 android:layout_width="16dp" />

            <ImageButton
                 android:layout_height="48dp"
                 android:layout_width="48dp"
                 android:src="@drawable/ic_facebook"
                 android:scaleType="centerInside"
                 android:contentDescription="@string/facebook_sign_in"
                 android:background="@drawable/bg_social_button"
                 android:padding="0dp"
                 android:id="@+id/btn_social_facebook" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>