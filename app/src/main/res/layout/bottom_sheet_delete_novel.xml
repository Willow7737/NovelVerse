<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Novel cover card with red overlay -->
    <androidx.cardview.widget.CardView
        android:id="@+id/delete_cover_card"
        android:layout_width="80dp"
        android:layout_height="110dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/delete_cover_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_placeholder_cover" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55EF4444" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="Delete Novel?"
        android:textColor="?attr/colorOnSurface"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/delete_novel_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:text="This novel will be permanently deleted — all chapters, analytics, and reader data will be gone forever. This cannot be undone."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_delete_forever"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_btn_squircle_destructive"
        android:fontFamily="@font/inter_semibold"
        android:text="Delete Forever"
        android:textColor="#EF4444"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_keep_novel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_squircle_secondary"
        android:fontFamily="@font/inter_medium"
        android:text="Keep Novel"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp" />

</LinearLayout>
