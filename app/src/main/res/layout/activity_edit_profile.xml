<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="?attr/colorSurface">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn_white"
            android:src="@drawable/ic_back"
            android:tint="?attr/colorOnSurfaceVariant"
            android:padding="10dp"
            android:contentDescription="Back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Edit Profile"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:fontFamily="@font/inter_semibold" />
        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_primary"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:text="Save"
            android:textColor="?attr/colorSurface"
            android:textSize="15sp"
            android:fontFamily="@font/inter_semibold" />
    </LinearLayout>
    <!-- Bluesky hairline divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Cover photo change -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="120dp">

                <ImageView
                    android:id="@+id/edit_cover_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_profile_banner"
                    android:contentDescription="Cover photo" />

                <!-- Camera button - bottom right -->
                <FrameLayout
                    android:id="@+id/btn_change_cover"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_cover_edit_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        android:tint="#FFFFFF"
                        android:contentDescription="Change cover photo" />

                </FrameLayout>

            </FrameLayout>

            <!-- Avatar change -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/colorSurface"
                android:paddingVertical="24dp">
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_avatar_circle">
                    <ImageView
                        android:id="@+id/edit_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                    <TextView
                        android:id="@+id/edit_avatar_initials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"
                        android:fontFamily="@font/inter_semibold" />
                </FrameLayout>
                <TextView
                    android:id="@+id/btn_change_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Change Photo"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_medium" />
            </LinearLayout>

            <!-- Form fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:layout_marginHorizontal="14dp"
                android:background="@drawable/bg_surface_card"
                android:padding="16dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE INFO"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_semibold"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/edit_display_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="14dp"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Your display name"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/edit_username"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="14dp"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="@username"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bio"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/edit_bio"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Tell readers about yourself"
                    android:gravity="top"
                    android:maxLines="4"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
