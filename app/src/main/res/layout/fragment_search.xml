<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@android:color/transparent"
     android:orientation="vertical">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:background="?attr/colorSurface"
         android:orientation="horizontal"
         android:paddingBottom="10dp"
         android:paddingHorizontal="16dp"
         android:paddingTop="12dp">

        <FrameLayout
             android:layout_height="44dp"
             android:layout_width="0dp"
             android:background="@drawable/bg_search_bar"
             android:layout_weight="1">

            <ImageView
                 android:layout_height="18dp"
                 android:layout_width="18dp"
                 android:src="@drawable/ic_search"
                 android:contentDescription="Search"
                 android:tint="?attr/colorOnSurfaceVariant"
                 android:layout_marginStart="14dp"
                 android:layout_gravity="start|center_vertical" />

            <EditText
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:imeOptions="actionSearch"
                 android:textSize="15sp"
                 android:textColor="?attr/colorOnSurface"
                 android:singleLine="true"
                 android:paddingStart="42dp"
                 android:paddingEnd="12dp"
                 android:background="@android:color/transparent"
                 android:hint="Search novels, authors, genres…"
                 android:textColorHint="@color/text_tertiary"
                 android:fontFamily="@font/inter_regular"
                 android:inputType="text"
                 android:id="@+id/search_input" />

        </FrameLayout>

    </LinearLayout>

    <View
         android:layout_height="1dp"
         android:layout_width="match_parent"
         android:background="@color/divider" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         android:paddingBottom="4dp"
         android:paddingHorizontal="16dp"
         android:paddingTop="8dp">

        <com.google.android.material.chip.ChipGroup
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             app:singleSelection="true"
             app:selectionRequired="true"
             android:layout_weight="1"
             android:id="@+id/search_mode_chips">

            <com.google.android.material.chip.Chip
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:checked="true"
                 android:id="@+id/chip_mode_novels"
                 android:text="Novels" />

            <com.google.android.material.chip.Chip
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:id="@+id/chip_mode_authors"
                 android:text="Authors" />

            <com.google.android.material.chip.Chip
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:id="@+id/chip_mode_characters"
                 android:text="Characters" />

        </com.google.android.material.chip.ChipGroup>

        <FrameLayout
             android:layout_height="40dp"
             android:layout_width="40dp">

            <ImageView
                 android:layout_height="36dp"
                 android:layout_width="36dp"
                 android:src="@drawable/ic_filter_outline"
                 android:contentDescription="Filter"
                 android:padding="6dp"
                 android:tint="?attr/colorOnSurfaceVariant"
                 android:id="@+id/btn_search_filter" />

            <TextView
                 android:layout_height="16dp"
                 android:layout_width="16dp"
                 android:visibility="gone"
                 android:background="@drawable/bg_btn_primary"
                 android:gravity="center"
                 android:textSize="10sp"
                 android:textColor="?attr/colorSurface"
                 android:id="@+id/filter_badge_count"
                 android:layout_gravity="top|end" />

        </FrameLayout>

    </LinearLayout>

    <View
         android:layout_height="1dp"
         android:layout_width="match_parent"
         android:background="@color/divider" />

    <androidx.core.widget.NestedScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:paddingBottom="96dp">

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:paddingHorizontal="16dp"
                 android:id="@+id/section_recent"
                 android:paddingTop="20dp">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:layout_marginBottom="10dp"
                     android:gravity="center_vertical"
                     android:orientation="horizontal">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="0dp"
                         android:textSize="16sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:layout_weight="1"
                         android:text="Recent Searches" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="14sp"
                         android:fontFamily="@font/inter_medium"
                         android:textColor="?attr/colorPrimary"
                         android:id="@+id/btn_clear_recent"
                         android:text="Clear" />

                </LinearLayout>

                <HorizontalScrollView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:scrollbars="none">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:orientation="horizontal"
                         android:id="@+id/recent_chips_container">

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:paddingHorizontal="16dp"
                 android:paddingTop="24dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_marginBottom="10dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:text="Trending" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:background="@drawable/bg_surface_card"
                     android:orientation="vertical"
                     android:id="@+id/trending_container">

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:paddingHorizontal="16dp"
                 android:paddingTop="24dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_marginBottom="10dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:text="Browse by Genre" />

                <androidx.recyclerview.widget.RecyclerView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:nestedScrollingEnabled="false"
                     android:id="@+id/genre_grid_rv" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:visibility="gone"
                 android:orientation="vertical"
                 android:paddingHorizontal="16dp"
                 android:id="@+id/results_section"
                 android:paddingTop="16dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_marginBottom="10dp"
                     android:textSize="16sp"
                     android:fontFamily="@font/inter_semibold"
                     android:textColor="?attr/colorOnSurface"
                     android:id="@+id/results_label"
                     android:text="Results" />

                <androidx.recyclerview.widget.RecyclerView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:nestedScrollingEnabled="false"
                     android:id="@+id/search_results_rv" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:visibility="gone"
                     android:gravity="center"
                     android:paddingVertical="40dp"
                     android:orientation="vertical"
                     android:id="@+id/empty_results">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="40sp"
                         android:text="🔍" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="17sp"
                         android:fontFamily="@font/inter_semibold"
                         android:textColor="?attr/colorOnSurface"
                         android:layout_marginTop="12dp"
                         android:text="No results found" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:gravity="center"
                         android:textSize="14sp"
                         android:fontFamily="@font/inter_regular"
                         android:textColor="?attr/colorOnSurfaceVariant"
                         android:layout_marginTop="6dp"
                         android:text="Try a different term or browse genres below" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>