<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable onboarding bottom-sheet layout.
  Structure (top → bottom):
    1. Tutorial image
    2. Title
    3. Body text
    4. "Don't show again" checkbox
    5. "Got it" primary button
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Tutorial image (full-width, fixed height) -->
    <ImageView
        android:id="@+id/onboarding_image"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="20dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="Tutorial illustration" />

    <!-- Title -->
    <TextView
        android:id="@+id/onboarding_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="24dp"
        android:textSize="20sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="?attr/colorOnSurface"
        android:gravity="start"
        android:lineSpacingMultiplier="1.2" />

    <!-- Body -->
    <TextView
        android:id="@+id/onboarding_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="24dp"
        android:textSize="14sp"
        android:fontFamily="@font/inter_regular"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:lineSpacingMultiplier="1.5" />

    <!-- Don't remind checkbox -->
    <CheckBox
        android:id="@+id/onboarding_dont_show_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginStart="20dp"
        android:text="Don\'t remind me again"
        android:textSize="13sp"
        android:fontFamily="@font/inter_regular"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:buttonTint="@color/primary" />

    <!-- Got it button -->
    <TextView
        android:id="@+id/onboarding_cta_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_btn_primary"
        android:gravity="center"
        android:text="Got it"
        android:textSize="15sp"
        android:fontFamily="@font/inter_semibold"
        android:textColor="?attr/colorSurface" />

</LinearLayout>
