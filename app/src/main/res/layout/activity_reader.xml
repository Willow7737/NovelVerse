<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_background_light">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/reader_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="72dp"
            android:paddingBottom="120dp"
            android:paddingHorizontal="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:id="@+id/skeleton_chapter_title"
                    android:layout_width="200dp"
                    android:layout_height="24dp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/chapter_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/reader_text_light"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter_semibold"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/skeleton_content_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginBottom="10dp" />
                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginBottom="10dp" />
                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="240dp"
                    android:layout_height="14dp"
                    android:layout_marginBottom="24dp" />
                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginBottom="10dp" />
                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginBottom="10dp" />
                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="180dp"
                    android:layout_height="14dp"
                    android:layout_marginBottom="24dp" />
                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginBottom="10dp" />
                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginBottom="10dp" />
                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:layout_width="200dp"
                    android:layout_height="14dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/chapter_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/reader_text_light"
                android:textSize="17sp"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingMultiplier="1.6"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:textIsSelectable="true"
                android:textSelectHandle="@drawable/ic_caret"
                android:textSelectHandleLeft="@drawable/ic_caret"
                android:textSelectHandleRight="@drawable/ic_caret"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Paged mode -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/reader_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/reader_top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_btn_white"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:tint="@color/text_secondary"
            android:contentDescription="Back" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp">

            <com.novelverse.app.presentation.common.views.ShimmerView
                android:id="@+id/skeleton_novel_title"
                android:layout_width="140dp"
                android:layout_height="16dp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/reader_novel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </FrameLayout>

        <com.novelverse.app.presentation.common.views.CurrencyHudView
            android:id="@+id/reader_currency_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <!-- ── RIGHT: Pill — search | divider | notifications ─ -->
        <LinearLayout
            android:layout_height="38dp"
            android:layout_width="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_header_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_play_music"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_music"
                android:padding="10dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Play music" />

            <!-- Broken vertical divider (inset from top/bottom gives the gap effect) -->
            <View
                android:layout_height="16dp"
                android:layout_width="1dp"
                android:background="#3C3C3E" />

            <ImageView
                android:id="@+id/btn_reader_tts"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_headphones"
                android:padding="10dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Read aloud" />

            <!-- Broken vertical divider (inset from top/bottom gives the gap effect) -->
            <View
                android:layout_height="16dp"
                android:layout_width="1dp"
                android:background="#3C3C3E" />

            <ImageView
                android:id="@+id/btn_reader_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_gear"
                android:padding="10dp"
                android:contentDescription="Reader settings" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/reader_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />

            <SeekBar
                android:id="@+id/reader_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btn_prev_chapter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chapter_nav_inactive"
                android:src="@drawable/ic_arrow_left"
                android:padding="12dp"
                android:contentDescription="Previous chapter" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center">

                <com.novelverse.app.presentation.common.views.ShimmerView
                    android:id="@+id/skeleton_chapter_label"
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/chapter_number_label"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Chapter 1 of 1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_semibold"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btn_next_chapter"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chapter_nav_inactive"
                android:src="@drawable/ic_arrow_right"
                android:padding="12dp"
                android:contentDescription="Next chapter" />
        </LinearLayout>
    </LinearLayout>

    <!-- TtsMiniPlayerFragment is added here at runtime. The FrameLayout is match_parent + transparent so the Fragment's drag math uses correct screen coords. -->
    <FrameLayout
        android:id="@+id/tts_mini_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
