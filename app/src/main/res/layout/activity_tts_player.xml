<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_tts_player.xml  –  Lean TTS reader
  Dark slate-black. Top bar: back + small squircle cover top-left + titles.
  Body: full chapter text with past/current/future sentence colouring.
  Controls live in a bottom sheet, opened via a small persistent button.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14">

    <!-- ── Scrollable chapter text ──────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tts_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="64dp"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/tts_chapter_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="22dp"
            android:paddingVertical="16dp"
            android:textSize="16sp"
            android:fontFamily="@font/inter_semibold"
            android:lineSpacingMultiplier="1.75"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:textColor="#AAFFFFFF"
            android:text="Loading…" />

    </androidx.core.widget.NestedScrollView>

    <!-- ── Top bar overlay ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/tts_top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="#E60D0F14"
        android:elevation="4dp">

        <!-- Back -->
        <ImageView
            android:id="@+id/tts_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:padding="10dp"
            android:tint="#BBFFFFFF"
            android:background="@drawable/bg_tts_small_btn"
            android:layout_marginEnd="12dp"
            android:contentDescription="Back" />

        <!-- Small squircle cover -->
        <FrameLayout
            android:id="@+id/tts_cover_frame"
            android:layout_width="34dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_tts_cover_squircle"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <ImageView
                android:id="@+id/tts_img_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/img_cover_placeholder_default" />
        </FrameLayout>

        <!-- Titles column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tts_novel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Novel Title"
                android:textSize="13sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#EEFFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tts_chapter_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter"
                android:textSize="11sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="#55FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── Controls pill (bottom-center, fixed) ────────────────────── -->
    <LinearLayout
        android:id="@+id/tts_controls_bar"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_reader_fab_horizontal"
        android:elevation="10dp"
        android:paddingHorizontal="6dp">

        <!-- Prev -->
        <ImageView
            android:id="@+id/tts_btn_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_left"
            android:padding="10dp"
            android:tint="#AAFFFFFF"
            android:background="@drawable/bg_tts_small_btn"
            android:layout_marginHorizontal="3dp"
            android:contentDescription="Previous" />

        <!-- Play / Pause -->
        <ImageView
            android:id="@+id/tts_btn_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_play"
            android:padding="14dp"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_tts_play_btn"
            android:layout_marginHorizontal="3dp"
            android:contentDescription="Play or pause" />

        <!-- Next -->
        <ImageView
            android:id="@+id/tts_btn_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_right"
            android:padding="10dp"
            android:tint="#AAFFFFFF"
            android:background="@drawable/bg_tts_small_btn"
            android:layout_marginHorizontal="3dp"
            android:contentDescription="Next" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#22FFFFFF"
            android:layout_marginHorizontal="4dp" />

        <!-- Open full controls -->
        <ImageView
            android:id="@+id/tts_btn_open_controls"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_gear"
            android:padding="10dp"
            android:tint="#88FFFFFF"
            android:background="@drawable/bg_tts_small_btn"
            android:layout_marginHorizontal="3dp"
            android:contentDescription="Settings" />

    </LinearLayout>

</FrameLayout>
