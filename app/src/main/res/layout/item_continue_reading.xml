<?xml version="1.0" encoding="utf-8"?>
<!--
  Continue Reading card — Bluesky style
  • Outline card, no elevation
  • Rounded cover clipped inside MaterialCardView
  • Chapter label + % progress text below title
  • Thin progress bar at card bottom
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top row: cover + text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <!-- Rounded cover -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="72dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/cover_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/shimmer_base"
                    android:contentDescription="@string/cd_novel_cover" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Text block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/author_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="3dp" />

                <!-- Chapter + progress text row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/chapter_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/primary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Ch. 1" />

                    <TextView
                        android:id="@+id/progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="0%" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Progress bar — flush to card bottom -->
        <ProgressBar
            android:id="@+id/reading_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="?attr/colorSurfaceVariant"
            android:indeterminate="false" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
