<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════════════════════════════════════════════
         Base Theme — NovelVerse Light
         Background is ALWAYS deep charcoal — never switches.
         Only card surfaces (colorSurface) change between modes.
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.NovelVerse" parent="Theme.Material3.Light.NoActionBar">

        <!-- ── Brand ── -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryContainer">@color/icon_bg_tint</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/surface_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/secondary_dark</item>

        <item name="colorTertiary">@color/accent</item>
        <item name="colorTertiaryContainer">@color/success_light</item>
        <item name="colorOnTertiary">@color/on_accent</item>

        <!-- ── Backgrounds — charcoal is ALWAYS the window background ── -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@drawable/bg_app_main</item>

        <!-- ── Surface — WHITE cards in light mode ── -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <!-- ── Text on background — ALWAYS white (charcoal bg never changes) ── -->
        <item name="colorOnBackground">@color/text_primary_dark</item>

        <!-- ── Text on surface — DARK in light mode (white cards) ── -->
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- ── Error ── -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_light</item>
        <item name="colorOnError">@color/white</item>

        <!-- ── Outline ── -->
        <item name="colorOutline">@color/border</item>

        <!-- ── Status / nav bar — always dark (charcoal bg = dark icons) ── -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- ── Typography — Nunito SemiBold as primary face ── -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.NovelVerse.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.NovelVerse.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.NovelVerse.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.NovelVerse.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.NovelVerse.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.NovelVerse.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.NovelVerse.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.NovelVerse.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.NovelVerse.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.NovelVerse.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.NovelVerse.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.NovelVerse.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.NovelVerse.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.NovelVerse.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.NovelVerse.LabelSmall</item>

        <!-- ── Shapes ── -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.NovelVerse.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.NovelVerse.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.NovelVerse.LargeComponent</item>

        <!-- ── Components ── -->
        <item name="materialButtonStyle">@style/Widget.NovelVerse.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.NovelVerse.Button.Outlined</item>
        <item name="textButtonStyle">@style/Widget.NovelVerse.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.NovelVerse.Card</item>
        <item name="textInputStyle">@style/Widget.NovelVerse.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.NovelVerse.BottomNav</item>
        <item name="toolbarStyle">@style/Widget.NovelVerse.Toolbar</item>
        <item name="tabStyle">@style/Widget.NovelVerse.Tab</item>
        <item name="chipStyle">@style/Widget.NovelVerse.Chip</item>
        <item name="snackbarStyle">@style/Widget.NovelVerse.Snackbar</item>
        <item name="bottomSheetDialogTheme">@style/Theme.NovelVerse.BottomSheet</item>

        <!-- ── Custom NovelVerse Attributes ── -->
        <item name="colorSurfaceCardStroke">@color/surface_card_stroke</item>
        <item name="colorSurfaceCardSecondary">@color/surface_card_secondary</item>
        <item name="colorSurfaceCardTertiary">@color/surface_card_tertiary</item>
        <item name="colorDragHandle">@color/drag_handle</item>
        <item name="colorIconBgTint">@color/icon_bg_tint</item>
        <item name="colorIconTintPrimary">@color/icon_tint_primary</item>
        <item name="colorButtonSecondaryBg">@color/button_secondary_bg</item>
        <item name="colorChipInactiveBg">@color/chip_inactive_bg</item>
        <item name="colorChipInactiveStroke">@color/chip_inactive_stroke</item>
        <item name="colorSearchBarBg">@color/search_bar_bg</item>
    </style>


    <!-- ════════════════════════════════════════════════════════════════
         Splash Theme
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.NovelVerse.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
    </style>


    <!-- ════════════════════════════════════════════════════════════════
         Onboarding Theme — White background, light status bar
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.NovelVerse.Onboarding" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorPrimary">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════
         Bottom Sheet — Glassmorphism
         The drawable provides the semi-transparent frosted container.
         System blur (API 31+) must be enabled in your Fragment:

           override fun onCreateDialog(...): Dialog {
               return super.onCreateDialog(args).also { dialog ->
                   dialog.window?.let { w ->
                       w.addFlags(WindowManager.LayoutParams.FLAG_BLUR_BEHIND)
                       WindowCompat.setDecorFitsSystemWindows(w, false)
                       if (Build.VERSION.SDK_INT >= 31) {
                           w.attributes.blurBehindRadius = 24
                           w.addFlags(WindowManager.LayoutParams.FLAG_BLUR_BEHIND)
                       }
                   }
               }
           }
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.NovelVerse.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.NovelVerse.BottomSheet</item>
        <!-- API 31+ system blur hint — gracefully ignored below 31 -->
        <item name="android:windowBlurBehindEnabled" tools:targetApi="s">true</item>
        <item name="android:windowBlurBehindRadius" tools:targetApi="s">24dp</item>
        
    </style>

    <style name="Widget.NovelVerse.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.NovelVerse.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.NovelVerse.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>


    <!-- ════════════════════════════════════════════════════════════════
         Typography — Nunito SemiBold as primary face
         Display / Headline / Title / Label → nunito_semibold
         Body → nunito_regular  (readability first in long text)
         ════════════════════════════════════════════════════════════════ -->
    <style name="TextAppearance.NovelVerse.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.NovelVerse.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.NovelVerse.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>

    <style name="TextAppearance.NovelVerse.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.NovelVerse.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.NovelVerse.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>

    <style name="TextAppearance.NovelVerse.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>
    <style name="TextAppearance.NovelVerse.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>
    <style name="TextAppearance.NovelVerse.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>

    <!-- Body stays Nunito Regular — semibold in body text is fatiguing -->
    <style name="TextAppearance.NovelVerse.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>
    <style name="TextAppearance.NovelVerse.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>
    <style name="TextAppearance.NovelVerse.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/nunito_regular</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- Labels — SemiBold for UI control text -->
    <style name="TextAppearance.NovelVerse.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>
    <style name="TextAppearance.NovelVerse.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>
    <style name="TextAppearance.NovelVerse.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>


    <!-- ════════════════════════════════════════════════════════════════
         Shape Appearances
         ════════════════════════════════════════════════════════════════ -->
    <style name="ShapeAppearance.NovelVerse.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.NovelVerse.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.NovelVerse.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>


    <!-- ════════════════════════════════════════════════════════════════
         Component Styles
         ════════════════════════════════════════════════════════════════ -->

    <!-- Button — rose-red fill, pill-shaped -->
    <style name="Widget.NovelVerse.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>

    <style name="Widget.NovelVerse.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>

    <style name="Widget.NovelVerse.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>

    <!-- Card — zero elevation, hairline border, 16dp radius -->
    <style name="Widget.NovelVerse.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
    </style>

    <!-- TextInput — rounded outline -->
    <style name="Widget.NovelVerse.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/border</item>
    </style>

    <!-- Bottom Nav — transparent, floats over charcoal bg -->
    <style name="Widget.NovelVerse.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="elevation">0dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.NovelVerse.NavActiveIndicator</item>
    </style>

    <style name="Widget.NovelVerse.NavActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">52dp</item>
        <item name="android:height">36dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NovelVerse.NavIndicator</item>
        <item name="android:color">#33E8395A</item>   <!-- rose-red at 20% opacity -->
    </style>

    <style name="ShapeAppearance.NovelVerse.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Toolbar — transparent so charcoal bg shows through, white title text -->
    <style name="Widget.NovelVerse.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.NovelVerse.TitleLarge</item>
        <item name="titleTextColor">@color/text_primary_dark</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Tabs — rose-red indicator, white active text on charcoal bg -->
    <style name="Widget.NovelVerse.Tab" parent="Widget.Material3.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.NovelVerse.LabelLarge</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabTextColor">@color/text_tertiary_dark</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabBackground">@android:color/transparent</item>
    </style>
    <!-- Note: text_tertiary_dark is a missing alias — use #636366 directly or
         add <color name="text_tertiary_dark">#636366</color> to colors.xml -->

    <!-- Chip — rose-red active fill -->
    <style name="Widget.NovelVerse.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">100dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_color</item>
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>

    <!-- Snackbar -->
    <style name="Widget.NovelVerse.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="android:layout_margin">16dp</item>
        <item name="cornerRadius">12dp</item>
    </style>


    <!--
      BottomSheetTheme — backward-compat alias.
      Your Java code calls: new BottomSheetDialog(context, R.style.BottomSheetTheme)
      This alias keeps that working while delegating to the glass bottom sheet style.
    -->
    <style name="BottomSheetTheme" parent="Theme.NovelVerse.BottomSheet">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.NovelVerse.BottomSheet" />


    <!-- Full-screen image viewer: true black, no action bar, edge-to-edge -->
    <style name="Theme.NovelVerse.ImageViewer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

</resources>
