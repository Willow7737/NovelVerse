<?xml version="1.0" encoding="utf-8"?>
<!--
  drawable-night/bg_bottom_sheet_glass.xml
  Intentionally identical to the day version.
  The bottom sheet is always dark glass — it does not switch with mode.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Frosted charcoal base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0141416" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Frosting shimmer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0CFFFFFF" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Specular glass edge -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1EFFFFFF" />
            <solid android:color="#00000000" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

</layer-list>
