<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_header_pill.xml
  Outline-only pill for the header search/notification group.
  Transparent fill so the charcoal background shows through.
  Border matches the existing surface stroke colour in the dark system.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="#E5E5EA" />
    <corners android:radius="100dp" />
</shape>
