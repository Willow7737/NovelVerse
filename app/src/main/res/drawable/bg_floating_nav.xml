<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_floating_nav.xml — Floating pill nav with glass morphism.
  Semi-transparent charcoal + white specular stroke.
  Replaces the old opaque dark #13131F.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Frosted glass base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D8141416" />
            <corners android:radius="36dp" />
        </shape>
    </item>

    <!-- Frosting layer — barely-there white haze -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF" />
            <corners android:radius="36dp" />
        </shape>
    </item>

    <!-- Specular border — thin white glass edge -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#18FFFFFF" />
            <solid android:color="#00000000" />
            <corners android:radius="36dp" />
        </shape>
    </item>

</layer-list>
